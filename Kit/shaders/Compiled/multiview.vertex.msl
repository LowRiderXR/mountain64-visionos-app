#pragma clang diagnostic ignored "-Wmissing-prototypes"
#pragma clang diagnostic ignored "-Wmissing-braces"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

template<typename T, size_t Num>
struct spvUnsafeArray
{
    T elements[Num ? Num : 1];
    
    thread T& operator [] (size_t pos) thread
    {
        return elements[pos];
    }
    constexpr const thread T& operator [] (size_t pos) const thread
    {
        return elements[pos];
    }
    
    device T& operator [] (size_t pos) device
    {
        return elements[pos];
    }
    constexpr const device T& operator [] (size_t pos) const device
    {
        return elements[pos];
    }
    
    constexpr const constant T& operator [] (size_t pos) const constant
    {
        return elements[pos];
    }
    
    threadgroup T& operator [] (size_t pos) threadgroup
    {
        return elements[pos];
    }
    constexpr const threadgroup T& operator [] (size_t pos) const threadgroup
    {
        return elements[pos];
    }
};

struct type_MultiviewUniforms
{
    float4x4 u_viewProjection[2];
    float4 u_center;
    float4 u_right;
    float4 u_up;
    float4 u_viewColor[2];
    float4 u_params;
};

constant spvUnsafeArray<float2, 6> _47 = spvUnsafeArray<float2, 6>({ float2(0.0), float2(1.0, 0.0), float2(1.0), float2(0.0), float2(1.0), float2(0.0, 1.0) });

struct vertex_main_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float4 out_var_COLOR0 [[user(locn1)]];
    float out_var_TEXCOORD1 [[user(locn2)]];
    float4 gl_Position [[position]];
};

vertex vertex_main_out vertex_main(constant type_MultiviewUniforms& MultiviewUniforms [[buffer(0)]], uint gl_VertexIndex [[vertex_id]], uint gl_InstanceIndex [[instance_id]], uint gl_BaseInstance [[base_instance]], uint gl_ViewIndex [[amplification_id]])
{
    vertex_main_out out = {};
    out.out_var_TEXCOORD0 = _47[gl_VertexIndex];
    out.out_var_COLOR0 = MultiviewUniforms.u_viewColor[gl_ViewIndex];
    out.out_var_TEXCOORD1 = MultiviewUniforms.u_params.x;
    out.gl_Position = MultiviewUniforms.u_viewProjection[gl_ViewIndex] * float4((MultiviewUniforms.u_center.xyz + (MultiviewUniforms.u_right.xyz * ((_47[gl_VertexIndex].x * 2.0) - 1.0))) + (MultiviewUniforms.u_up.xyz * ((_47[gl_VertexIndex].y * 2.0) - 1.0)), 1.0);
    return out;
}

