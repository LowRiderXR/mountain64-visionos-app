+	public static Target EnsureUILayer(GraphicsDevice device)
+	{
+		if (UILayer == null || UILayer.Width != InternalWidth || UILayer.Height != InternalHeight)
+		{
+			UILayer = new Target(device, InternalWidth, InternalHeight, [TextureFormat.Color], name: "ui-layer");
+			Log.Info($"[c64-ui] layer {InternalWidth}x{InternalHeight} (colour only, cleared transparent in every frame that uses it)");
+		}
+		return UILayer;
+	}
