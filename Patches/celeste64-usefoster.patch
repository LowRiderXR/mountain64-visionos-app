+	/// <summary>How the game camera carries the head: Yaw = position and yaw of the game camera, pitch and roll only from the head (horizon level); Full = the whole rotation of the game camera (pitch included) as the base, the head on top.</summary>
+	public enum CameraBaseMode { Yaw, Full }
+
+	/// <summary>
+	/// Camera switches, read once from the environment; the static constructor logs every value
+	/// (the first frame that places the head triggers it).
+	/// C64_CAMERA: a (Yaw, default) or c (Full). C64_CAM_PITCH_DEG: target angle of Madeline below
+	/// the horizon on the stereo path (default 20), off = Celeste's own height curve.
+	/// C64_MOVE_REF: game (default, stick relative to the game camera's yaw) or head.
+	/// </summary>
+	public static class Cam
+	{
+		public static readonly CameraBaseMode Mode;
+		/// <summary>Target angle in degrees, null = Celeste's curve.</summary>
+		public static readonly float? PitchDegrees;
+		public static readonly bool MoveRelativeToHead;
+
+		static Cam()
+		{
+			var camera = Environment.GetEnvironmentVariable("C64_CAMERA");
+			Mode = camera switch { "c" => CameraBaseMode.Full, _ => CameraBaseMode.Yaw };
+			if (camera != null && camera != "a" && camera != "c")
+				Log.Warning($"[c64-cam] C64_CAMERA={camera} unknown, using a");
+			Log.Info($"[c64-cam] C64_CAMERA={(Mode == CameraBaseMode.Full ? "c" : "a")} ({(Mode == CameraBaseMode.Full ? "full rotation of the game camera as base" : "position and yaw of the game camera, pitch and roll from the head")})");
+
+			var pitch = Environment.GetEnvironmentVariable("C64_CAM_PITCH_DEG");
+			if (pitch == "off")
+				PitchDegrees = null;
+			else if (float.TryParse(pitch, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var degrees) && degrees > -80 && degrees < 80)
+				PitchDegrees = degrees;
+			else
+			{
+				if (pitch != null)
+					Log.Warning($"[c64-cam] C64_CAM_PITCH_DEG={pitch} invalid, using 20");
+				PitchDegrees = 20;
+			}
+			Log.Info($"[c64-cam] C64_CAM_PITCH_DEG={(PitchDegrees is { } p ? p.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) : "off")} ({(PitchDegrees.HasValue ? "height = 12 + distance * tan(angle) on the stereo path" : "Celeste's height curve")})");
+
+			var moveRef = Environment.GetEnvironmentVariable("C64_MOVE_REF");
+			MoveRelativeToHead = moveRef == "head";
+			if (moveRef != null && moveRef != "game" && moveRef != "head")
+				Log.Warning($"[c64-cam] C64_MOVE_REF={moveRef} unknown, using game");
+			Log.Info($"[c64-cam] C64_MOVE_REF={(MoveRelativeToHead ? "head" : "game")} (stick direction relative to the {(MoveRelativeToHead ? "head's" : "game camera's")} yaw)");
+		}
+	}
+
+	/// <summary>
+	/// Base rotation that carries the head pose (row-vector layout, rows = images of X, Y, Z):
+	/// Yaw mode: rotation about Z by the game camera's yaw; Full mode: right, forward and up of
+	/// the game camera (forward = LookAt - Position, up from the world's Z), falls back to the
+	/// yaw when the camera looks straight up or down.
+	/// </summary>
+	/// <summary>Set by the player while a strawberry is collected: the game camera's whole rotation carries the head (the world is dimmed to 10 %, the tilted horizon hardly shows), so Madeline and the berry stay framed as in the original.</summary>
+	public static bool CameraFullRotationOverride { get; set; }
+
+	public static Matrix BaseRotation(Vec3 position, Vec3 lookAt)
+	{
+		if (Cam.Mode == CameraBaseMode.Full || CameraFullRotationOverride)
+		{
+			var forward = lookAt - position;
+			var length = forward.Length();
+			if (length > 1e-6f)
+			{
+				forward /= length;
+				var right = Vec3.Cross(forward, Vec3.UnitZ);
+				var rightLength = right.Length();
+				if (rightLength > 1e-4f)
+				{
+					right /= rightLength;
+					var up = Vec3.Cross(right, forward);
+					return new Matrix(
+						right.X, right.Y, right.Z, 0,
+						forward.X, forward.Y, forward.Z, 0,
+						up.X, up.Y, up.Z, 0,
+						0, 0, 0, 1);
+				}
+			}
+		}
+		return Matrix.CreateRotationZ(BaseYaw(position, lookAt));
+	}
+
+	/// <summary>Pitch of the game camera towards its LookAt in degrees, positive = looking down.</summary>
+	public static float CameraPitchDegrees(Vec3 position, Vec3 lookAt)
+	{
+		var f = lookAt - position;
+		return MathF.Atan2(-f.Z, MathF.Sqrt(f.X * f.X + f.Y * f.Y)) * 180 / MathF.PI;
+	}
+
+	/// <summary>
+	/// Camera probe [c64-cam]: counters the player's camera code increments per frame, rates and
+	/// angles sampled once per game tick in World.Update, one log line per second (wall clock).
+	/// Nothing here runs on the render path.
+	/// </summary>
+	public static class CamProbe
+	{
+		/// <summary>Frames in which the right stick turned the camera.</summary>
+		public static int StickTurnFrames;
+		/// <summary>Frames in which a FixedCamera zone set the camera.</summary>
+		public static int FixedZoneFrames;
+		/// <summary>Frames in which a camera override (strawberry, cassette) replaced the target.</summary>
+		public static int OverrideFrames;
+		/// <summary>Frames in which the ray-cast against solids moved the camera (wall or ceiling).</summary>
+		public static int CamHitFrames;
+		/// <summary>The player's zoom value 0..1 (0.5 = default).</summary>
+		public static float Zoom;
+
+		private static readonly Stopwatch clock = new();
+		private static bool hasPrevious;
+		private static Vec3 previousPosition;
+		private static float previousYaw;
+		private static int previousHeadVersion = -1;
+		private static float previousHeadYaw;
+		private static int frames;
+		private static float speedSum, speedMax, yawRateSum, yawRateMax, headYawRateSum, headYawRateMax;
+		private static int headSamples;
+
+		private static float WrapDegrees(float degrees)
+		{
+			while (degrees > 180) degrees -= 360;
+			while (degrees < -180) degrees += 360;
+			return degrees;
+		}
+
+		/// <summary>Head yaw and pitch (degrees, yaw positive to the right, pitch positive up) and position (metres) relative to O, from the last stereo pose.</summary>
+		private static (Vec3 position, float yaw, float pitch) HeadOf(StereoPose pose)
+		{
+			var h = pose.Head;
+			var forward = -new Vec3(h.M31, h.M32, h.M33);
+			var yaw = MathF.Atan2(forward.X, -forward.Z) * 180 / MathF.PI;
+			var pitch = MathF.Atan2(forward.Y, MathF.Sqrt(forward.X * forward.X + forward.Z * forward.Z)) * 180 / MathF.PI;
+			return (new Vec3(h.M41, h.M42, h.M43), yaw, pitch);
+		}
+
+		public static void Update(in Camera camera, float delta)
+		{
+			if (!clock.IsRunning)
+				clock.Start();
+			var position = camera.Position;
+			var yaw = BaseYaw(position, camera.LookAt) * 180 / MathF.PI;
+			if (hasPrevious && delta > 0)
+			{
+				var speed = (position - previousPosition).Length() / delta;
+				speedSum += speed;
+				speedMax = MathF.Max(speedMax, speed);
+				var yawRate = MathF.Abs(WrapDegrees(yaw - previousYaw)) / delta;
+				yawRateSum += yawRate;
+				yawRateMax = MathF.Max(yawRateMax, yawRate);
+				frames++;
+			}
+			previousPosition = position;
+			previousYaw = yaw;
+			hasPrevious = true;
+
+			var session = StereoSession;
+			if (session != null && session.Version != previousHeadVersion && delta > 0)
+			{
+				var head = HeadOf(session);
+				if (previousHeadVersion >= 0)
+				{
+					var rate = MathF.Abs(WrapDegrees(head.yaw - previousHeadYaw)) / delta;
+					headYawRateSum += rate;
+					headYawRateMax = MathF.Max(headYawRateMax, rate);
+					headSamples++;
+				}
+				previousHeadVersion = session.Version;
+				previousHeadYaw = head.yaw;
+			}
+
+			if (clock.Elapsed.TotalSeconds < 1)
+				return;
+			clock.Restart();
+			var pitchDeg = Cam.PitchDegrees is { } p ? p.ToString("F0", System.Globalization.CultureInfo.InvariantCulture) : "off";
