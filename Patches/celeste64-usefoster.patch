diff --git a/Content/Shaders/UpscaleVRArray.hlsl b/Content/Shaders/UpscaleVRArray.hlsl
new file mode 100644
index 0000000..3033fb7
--- /dev/null
+++ b/Content/Shaders/UpscaleVRArray.hlsl
@@ -0,0 +1,82 @@
+// visionOS port, pixel look: enlarges the coarse composite B (colour and depth, one layer per
+// eye) into the host's drawable without filtering. One full-screen quad in the logical space of
+// the drawable, vertex amplification for the two views. The texture coordinates are interpolated
+// in that logical space even under a rasterization rate map, so every logical pixel of the
+// drawable takes the coarse texel it falls into and the blocks are equally sized across the view
+// (uniform in tangent space, like the game's own raster). The depth of the texel goes out as
+// SV_Depth for the compositor. Compiled by scripts/compile-vr-shaders.sh.
+#include "Partials/Methods.hlsl"
+
+// Vertex Shader
+
+cbuffer VertexUniforms : register(b0, space1)
+{
+    float4x4 Matrix;
+};
+
+struct VsInput
+{
+    float2 Position : TEXCOORD0;
+    float2 TexCoord : TEXCOORD1;
+    float4 Color : TEXCOORD2;
+    float4 Type : TEXCOORD4;
+};
+
+struct VsOutput
+{
+    float2 TexCoord : TEXCOORD0;
+    // view index (SV_ViewID, vertex amplification) for the fragment stage: the layer of B
+    nointerpolation uint View : TEXCOORD5;
+    float4 Position : SV_Position;
+};
+
+VsOutput vertex_main(VsInput input, uint viewID : SV_ViewID)
+{
+    VsOutput output;
+    output.TexCoord = input.TexCoord;
+    output.View = viewID;
+    output.Position = mul(Matrix, float4(input.Position, 0.0, 1.0));
+    return output;
+}
+
+// Fragment Shader
+
+cbuffer FragmentUniforms : register(b0, space3)
+{
+	// fraction of the coarse texture the frame uses per eye (the texture has a fixed size, the
+	// frustum of the frame fills only part of it); size of the drawable texture (only the
+	// negative test divides the physical position by it); SrgbOut converts the output to linear
+	// for the sRGB drawable; TestPhysicalUV 1 samples with the physical instead of the logical
+	// position, which is wrong under a rate map (Mac check)
+	float2 Used0;
+	float2 Used1;
+	float2 PhysicalSize;
+	float SrgbOut;
+	float TestPhysicalUV;
+};
+
+Texture2DArray Texture : register(t0, space2);
+SamplerState TextureSampler : register(s0, space2);
+
+Texture2DArray Depth : register(t1, space2);
+SamplerState DepthSampler : register(s1, space2);
+
+struct UpscaleOutput
+{
+	float4 color : SV_Target0;
+	float depthOut : SV_Depth;
+};
+
+UpscaleOutput fragment_main(VsOutput input)
+{
+	float2 uv = lerp(input.TexCoord, input.Position.xy / PhysicalSize, TestPhysicalUV);
+	uv *= input.View == 0 ? Used0 : Used1;
+	float3 at = float3(uv, input.View);
+	float4 col = Texture.Sample(TextureSampler, at);
+	float3 res = lerp(col.rgb, SrgbToLinear(col.rgb), SrgbOut);
+
+	UpscaleOutput output;
+	output.color = float4(res, col.a);
+	output.depthOut = Depth.Sample(DepthSampler, at).r;
+	return output;
+}
