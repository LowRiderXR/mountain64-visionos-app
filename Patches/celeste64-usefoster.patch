+#if VISIONOS_KIT
+// VisionOSKit.cs — Schalter des visionOS-Ports für Mac-Läufe (K6b, nur mit UseLocalFoster gebaut).
+//
+//   C64_GPU_TIMING=1  Celeste gibt Foster den Completion-Rückruf des SDL_GPU-Kits mit (K4a) und
+//                     loggt einmal pro Sekunde die Zahl der fertigen Command Buffer. Nur, wenn das
+//                     Kit-SDL geladen ist (statische Prüfung); sonst eine Logzeile «Kit fehlt».
+//   C64_DEPTH_CLIP=1  schaltet Fosters Depth-Clip-Schalter ein (F7).
+
+using System.Diagnostics;
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+using Foster.Framework;
+using static SDL3.SDL;
+
+namespace Celeste64;
+
+public static unsafe class VisionOSKit
+{
+	private static long completedTotal;
+	private static long completedLast;
+	private static readonly Stopwatch timer = Stopwatch.StartNew();
+	private static bool timing;
+
+	/// <summary>
+	/// Internal resolution of the game's world target, set by the host before the game is
+	/// created (Celeste's own value is 640x360). Game.Width, Game.Height and everything scaled
+	/// by Game.RelativeScale follow these values. The targets are created once with the game,
+	/// so a change after that has no effect.
+	/// </summary>
+	public static int InternalWidth { get; set; } = 640;
+	public static int InternalHeight { get; set; } = 360;
+
+	/// <summary>
+	/// Width of the outline drawn by the edge post pass, in pixels of the world target (1 is
+	/// Celeste's one-texel outline; the host raises it with the internal resolution). The edge
+	/// shader samples the depth at this offset.
+	/// </summary>
+	public static int EdgeLineWidth { get; set; } = 1;
+
+	/// <summary>Zusatz-Flags für die AppConfig aus den Umgebungsvariablen.</summary>
+	public static AppFlags Flags
+		=> Environment.GetEnvironmentVariable("C64_DEPTH_CLIP") == "1" ? AppFlags.DepthClip : AppFlags.None;
+
+	/// <summary>
+	/// Properties für die Device-Erzeugung (0 = keine). Der Rückruf ist ein unmanaged
+	/// Funktionszeiger ohne Delegate, deshalb AOT-fähig und ohne Lebensdauerfrage.
+	/// </summary>
+	public static uint CreateDeviceProperties()
+	{
+		if (Environment.GetEnvironmentVariable("C64_GPU_TIMING") != "1")
+			return 0;
+
+		if (!GraphicsDevice.IsKitSDLLoaded())
+		{
+			Log.Info("[c64-gpu] Kit fehlt, Callback nicht gesetzt (SDL ohne visionOS-Kit-Exporte)");
+			return 0;
+		}
+
+		var props = SDL_CreateProperties();
+		delegate* unmanaged[Cdecl]<nint, nint, void> callback = &OnCommandBufferCompleted;
+		SDL_SetPointerProperty(props, SDL_PROP_GPU_DEVICE_CREATE_METAL_COMMAND_BUFFER_COMPLETED_CALLBACK_POINTER, (nint)callback);
+		SDL_SetPointerProperty(props, SDL_PROP_GPU_DEVICE_CREATE_METAL_COMMAND_BUFFER_COMPLETED_USERDATA_POINTER, nint.Zero);
+		timing = true;
+		Log.Info("[c64-gpu] Callback gesetzt, Zählung der fertigen Command Buffer einmal pro Sekunde");
+		return props;
+	}
+
+	[UnmanagedCallersOnly(CallConvs = [typeof(CallConvCdecl)])]
+	private static void OnCommandBufferCompleted(nint userdata, nint mtlCommandBuffer)
+	{
+		Interlocked.Increment(ref completedTotal);
+	}
+
+	/// <summary>Anzahl der bisher fertigen Command Buffer (für Hosts wie Celeste64.MacHost).</summary>
+	public static long CompletedTotal => Interlocked.Read(ref completedTotal);
+
+	/// <summary>
+	/// Ausgabeziele für das Endbild statt des Fensters (K6d, F3): ein Durchgang pro Ziel, also
+	/// zum Beispiel ein Target pro Drawable-Schicht. null = Fenster wie bisher.
+	/// </summary>
+	public static IReadOnlyList<IDrawableTarget>? Outputs { get; set; }
+
+	/// <summary>Wird am Ende von Game.Render aufgerufen; der Host zeichnet damit eine Vorschau ins Fenster.</summary>
+	public static Action? AfterRender { get; set; }
+
+	/// <summary>
+	/// Wird pro Ausgabeziel nach dem Endbild aufgerufen, solange dessen Pass noch offen ist; der
+	/// Host kann im selben Pass weiterzeichnen (K6d.3: Test-Viereck in memoryless-Ziele).
+	/// </summary>
+	public static Action<IDrawableTarget>? AfterOutput { get; set; }
+
+	/// <summary>Wird nach dem Rendern der Szene ins Welt-Ziel aufgerufen (vor der Ausgabe); der Host liest es zurück.</summary>
+	public static Action<Target>? AfterSceneRender { get; set; }
+
+	/// <summary>Kantenglättung des Welt-Ziels aus C64_MSAA (1, 2, 4, 8; Standard 1).</summary>
+	public static SampleCount TargetSampleCount => Environment.GetEnvironmentVariable("C64_MSAA") switch
+	{
+		"2" => SampleCount.Two,
+		"4" => SampleCount.Four,
+		"8" => SampleCount.Eight,
+		_ => SampleCount.One,
+	};
+
+	/// <summary>
+	/// Welt-Ziel (Farbe und Tiefe) mit der Kantenglättung aus C64_MSAA. Celeste rendert
+	/// mehrere Pässe in dieses Ziel und sampelt seine Tiefe im Kantenpass (World.cs:874).
+	/// Reverse-Z path: Depth32 (float) instead of Depth16, because near / distance needs the
+	/// float range (the sky at 3 km is 3e-5, two steps of a 16-bit depth) and the device
+	/// drawables are depth32Float as well.
+	/// </summary>
+	public static Target CreateMainTarget(GraphicsDevice device, int width, int height)
+	{
+		var samples = TargetSampleCount;
+		if (samples != SampleCount.One)
+			Log.Info($"[c64-msaa] Welt-Ziel {width}x{height} mit {samples} ({device.Capabilities})");
+		// Celeste rendert in Standard-Z (nah = klein): Tiefenauflösung mit Min, damit Kantenpixel am
+		// Vordergrund hängen; die Samples bleiben gespeichert (MultiSampleStore), weil spätere
+		// Pässe (Rückkopie, Sprites, Erdbeere) das Ziel laden. Reverse-Z: nah = gross, also Max.
+		var depthFormat = ReverseZ ? TextureFormat.Depth32 : TextureFormat.Depth16;
+		var depthResolve = ReverseZ ? DepthResolveFilter.Max : DepthResolveFilter.Min;
+		MainTarget = new Target(device, width, height, [(TextureFormat.Color, TextureFlags.None, samples), (depthFormat, TextureFlags.None, samples)],
+			name: "world", multiSampleStore: true, depthResolve: depthResolve);
+		if (ReverseZ)
+			Log.Info($"[c64-depth] world target {width}x{height} depth={depthFormat} reverseZ=1 scale={WorldScale:F1} units/m");
+		return MainTarget;
+	}
+
+	// ---- Depth convention of the VR path (reverse-Z, infinite far plane) ----
+	//
+	// The device drawables expect hardware depth = near / distance (reverse-Z with an infinite
+	// far plane, as computeProjection produces it); the compositor treats depth 0 as "no
+	// content". Celeste's own convention is standard Z with a linear depth written by the
+	// fragment shaders (LinearizeDepth). With ReverseZ on, the shader variants DefaultVR,
+	// SpriteVR and EdgeVR (no SV_Depth) replace the originals, the projection becomes
+	// reverse-Z infinite, depth clears are 0 and the depth compares are swapped. The near plane
+	// comes from the host in metres (celeste_set_depth_near) and is converted here, at one place,
+	// with the world scale. The reference path (ReverseZ off) is unchanged.
+
+	/// <summary>
+	/// Reverse-Z path on or off. Set by the host before the game is created: the shader
+	/// variants are chosen when the assets load and the world target is created with the game.
+	/// </summary>
+	public static bool ReverseZ { get; set; }
+
+	/// <summary>World units per metre (M4b decision: 10). C64_WORLD_SCALE overrides it for experiments.</summary>
+	public static float WorldScale { get; } =
+		float.TryParse(Environment.GetEnvironmentVariable("C64_WORLD_SCALE"), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var scale) && scale > 0 ? scale : 10f;
+
+	// Near plane of the VR projection in metres, from the host; 0 = not set yet.
+	private static double nearMeters;
+	private static bool nearFallbackLogged;
+	private const double FallbackNearMeters = 0.1;
+
+	/// <summary>Near plane in metres as the host passed it (0 while unknown).</summary>
+	public static double NearMeters => nearMeters;
+
+	/// <summary>
+	/// Sets the near plane of the VR projection in metres (the host reads it from the layer's
+	/// default depth range). Any positive value; the cameras pick it up with their next change.
+	/// </summary>
+	public static void SetNearMeters(double meters)
+	{
+		if (!(meters > 0) || double.IsInfinity(meters))
+			throw new ArgumentOutOfRangeException(nameof(meters), $"near plane must be a positive finite distance in metres, got {meters}");
+		nearMeters = meters;
+		Log.Info($"[c64-depth] near={meters:F3} m -> {NearUnits:F2} units (scale {WorldScale:F1} units/m) reverseZ={(ReverseZ ? 1 : 0)}");
+	}
+
+	/// <summary>
+	/// Near plane of the VR projection in world units: near_m * scale. Before the host set a
+	/// value, 0.1 m with one warning line (the loading ticks run before the host's layer exists).
+	/// </summary>
+	public static float NearUnits
+	{
+		get
+		{
+			var meters = nearMeters;
+			if (meters <= 0)
+			{
+				meters = FallbackNearMeters;
+				if (!nearFallbackLogged)
+				{
+					nearFallbackLogged = true;
+					Log.Warning($"[c64-depth] near plane not set by the host yet, projection uses {meters:F3} m until celeste_set_depth_near");
+				}
+			}
+			return (float)(meters * WorldScale);
+		}
+	}
+
+	/// <summary>
+	/// Radius of the sky dome in metres on the VR path. 3 km: at that distance the stereo
+	/// disparity (0.064 m / 3000 m = 0.0012 degrees) is far below one display pixel, and a head
+	/// movement of 0.1 m shifts the sky by 0.002 degrees, so the compositor's reprojection with
+	/// depth keeps it still; the depth near / R = 0.1 / 3000 = 3.3e-5 stays well above 0 in a
+	/// float depth. Beyond a few kilometres nothing improves, and 1 km would already do.
+	/// </summary>
+	public const double SkyRadiusMeters = 3000;
+
+	/// <summary>Half size of Celeste's skybox cube in world units: the dome radius on the VR path, 300 in the reference.</summary>
+	public static float SkyboxSize => ReverseZ ? (float)(SkyRadiusMeters * WorldScale) : 300f;
+
+	/// <summary>Depth clear value: 0 (far) on the reverse-Z path, 1 in the reference.</summary>
+	public static float DepthClearValue => ReverseZ ? 0f : 1f;
+
+	/// <summary>Depth compare that passes nearer fragments: Greater on the reverse-Z path, Less in the reference.</summary>
+	public static DepthCompare CompareNearer => ReverseZ ? DepthCompare.Greater : DepthCompare.Less;
+
+	/// <summary>Depth compare that passes farther fragments (silhouettes behind geometry): Less on the reverse-Z path, Greater in the reference.</summary>
+	public static DepthCompare CompareFarther => ReverseZ ? DepthCompare.Less : DepthCompare.Greater;
+
+	/// <summary>
+	/// Projection a host puts in place of the cameras' own (the Mac check renders with a test
+	/// projection shaped like computeProjection). Only on the reverse-Z path; null = Celeste's
+	/// field-of-view projection. The cameras cache their projection and pick a new value up with
+	/// their next change.
+	/// </summary>
+	public static Matrix? ProjectionOverride { get; set; }
+
+	/// <summary>
+	/// Turns a standard right-handed projection (System.Numerics, depth 0..1) into reverse-Z
+	/// with an infinite far plane: clip z = near, clip w = view distance, so depth = near / distance.
+	/// </summary>
+	public static Matrix ReverseZInfinite(Matrix standard, float near)
+	{
+		var m = standard;
+		m.M33 = 0f;
+		m.M43 = near;
+		return m;
+	}
+
+	/// <summary>
+	/// Reverse-Z infinite projection from view tangents (left, right, top, bottom, all positive),
+	/// the shape of the compositor's computeProjection, with the current near plane in units.
+	/// Row-vector convention like Matrix.CreatePerspectiveOffCenter (right-handed, -Z forward).
+	/// </summary>
+	public static Matrix CreateProjectionFromTangents(float left, float right, float top, float bottom)
+	{
+		var m = Matrix.Identity;
+		m.M11 = 2f / (left + right);
+		m.M22 = 2f / (top + bottom);
+		m.M31 = (right - left) / (left + right);
+		m.M32 = (top - bottom) / (top + bottom);
+		m.M33 = 0f;
+		m.M34 = -1f;
+		m.M43 = NearUnits;
+		m.M44 = 0f;
+		return m;
+	}
+
+	/// <summary>
+	/// Finite standard-Z version of a reverse-Z infinite matrix, for the culling frustum: an
+	/// infinite reverse-Z matrix has no far plane and its near plane row extracts as a zero
+	/// normal (BoundingFrustum.CreatePlanes). Clip z becomes range * z_view + near * range with
+	/// z_view = -clip w, so column 2 is rebuilt from column 3 (clip w): this holds for a pure
+	/// projection and for a projection times a rigid view (the binocular culling matrix).
+	/// </summary>
+	public static Matrix CullingProjection(Matrix projection, float near, float far)
+	{
+		var m = projection;
+		var range = far / (near - far);
+		m.M13 = -range * m.M14;
+		m.M23 = -range * m.M24;
+		m.M33 = -range * m.M34;
+		m.M43 = -range * m.M44 + near * range;
+		return m;
+	}
+
+	/// <summary>
+	/// After the shaders are loaded: on the reverse-Z path the VR variants (no SV_Depth) take
+	/// the places of Default, Sprite and Edge, so the game's material lookups stay unchanged.
+	/// </summary>
+	public static void SelectShaderVariants(Dictionary<string, Material> materials)
+	{
+		if (!ReverseZ)
+			return;
+		foreach (var name in new[] { "Default", "Sprite", "Edge" })
+		{
+			if (!materials.TryGetValue(name + "VR", out var variant))
+				throw new Exception($"shader variant {name}VR is missing in Content/Shaders (run scripts/compile-vr-shaders.sh)");
+			materials[name] = variant;
+		}
+		// Default: the world shader without the far discard (hidden surface removal stays on, the
+		// image is identical without a far limit); with C64_FAR=800 the discard clips the faded far
+		// geometry and stays; C64_NODISCARD=0 forces the discard variant for comparisons
+		var defaultVariant = "DefaultVR";
+		if (NoDiscard)
+		{
+			if (!FarOff)
+				Log.Info("[c64-depth] far limit active (C64_FAR=800): DefaultVR with the far discard");
+			else if (!materials.TryGetValue("DefaultVRNoDiscard", out var noDiscard))
+				throw new Exception("shader variant DefaultVRNoDiscard is missing in Content/Shaders (run scripts/compile-vr-shaders.sh)");
+			else
+			{
+				materials["Default"] = noDiscard;
+				defaultVariant = "DefaultVRNoDiscard";
+			}
+		}
+		Log.Info($"[c64-depth] shader variants selected: {defaultVariant}, SpriteVR, EdgeVR (hardware depth, no SV_Depth)");
+	}
+
+	/// <summary>
+	/// C64_NODISCARD (default 1): the world pass uses the DefaultVR variant without the far
