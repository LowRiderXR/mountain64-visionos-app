+			if (session != null)
+			{
+				var head = HeadOf(session);
+				headText = $"head=({head.position.X:F2}, {head.position.Y:F2}, {head.position.Z:F2}) m headYawRel={head.yaw:F1} headPitch={head.pitch:F1} headYawRate(deg/s) mean={(headSamples > 0 ? headYawRateSum / headSamples : 0):F1} max={headYawRateMax:F1}";
+			}
+			Log.Info($"[c64-cam] mode={(Cam.Mode == CameraBaseMode.Full ? "c" : "a")} scale={WorldScale:F1} pitchDeg={pitchDeg} moveRef={(Cam.MoveRelativeToHead ? "head" : "game")} cam=({position.X:F1}, {position.Y:F1}, {position.Z:F1}) camYaw={yaw:F1} camPitch={CameraPitchDegrees(position, camera.LookAt):F1} zoom={Zoom:F2} camSpeed(u/s) mean={(frames > 0 ? speedSum / frames : 0):F1} max={speedMax:F1} yawRate(deg/s) mean={(frames > 0 ? yawRateSum / frames : 0):F1} max={yawRateMax:F1} stickTurn={StickTurnFrames} fixedZone={FixedZoneFrames} override={OverrideFrames} camHit={CamHitFrames} frames={frames} {headText}");
+			frames = 0;
+			speedSum = speedMax = yawRateSum = yawRateMax = headYawRateSum = headYawRateMax = 0;
+			headSamples = 0;
+			StickTurnFrames = FixedZoneFrames = OverrideFrames = CamHitFrames = 0;
+		}
+	}
