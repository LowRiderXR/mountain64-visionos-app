diff --git a/Source/VisionOSKit.cs b/Source/VisionOSKit.cs
new file mode 100644
index 0000000..9d3eb2f
--- /dev/null
+++ b/Source/VisionOSKit.cs
@@ -0,0 +1,557 @@
+#if VISIONOS_KIT
+// VisionOSKit.cs — Schalter des visionOS-Ports für Mac-Läufe (K6b, nur mit UseLocalFoster gebaut).
+//
+//   C64_GPU_TIMING=1  Celeste gibt Foster den Completion-Rückruf des SDL_GPU-Kits mit (K4a) und
+//                     loggt einmal pro Sekunde die Zahl der fertigen Command Buffer. Nur, wenn das
+//                     Kit-SDL geladen ist (statische Prüfung); sonst eine Logzeile «Kit fehlt».
+//   C64_DEPTH_CLIP=1  schaltet Fosters Depth-Clip-Schalter ein (F7).
+
+using System.Diagnostics;
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+using Foster.Framework;
+using static SDL3.SDL;
+
+namespace Celeste64;
+
+public static unsafe class VisionOSKit
+{
+	private static long completedTotal;
+	private static long completedLast;
+	private static readonly Stopwatch timer = Stopwatch.StartNew();
+	private static bool timing;
+
+	/// <summary>
+	/// Internal resolution of the game's world target, set by the host before the game is
+	/// created (Celeste's own value is 640x360). Game.Width, Game.Height and everything scaled
+	/// by Game.RelativeScale follow these values. The targets are created once with the game,
+	/// so a change after that has no effect.
+	/// </summary>
+	public static int InternalWidth { get; set; } = 640;
+	public static int InternalHeight { get; set; } = 360;
+
+	/// <summary>
+	/// Width of the outline drawn by the edge post pass, in pixels of the world target (1 is
+	/// Celeste's one-texel outline; the host raises it with the internal resolution). The edge
+	/// shader samples the depth at this offset.
+	/// </summary>
+	public static int EdgeLineWidth { get; set; } = 1;
+
+	/// <summary>Zusatz-Flags für die AppConfig aus den Umgebungsvariablen.</summary>
+	public static AppFlags Flags
+		=> Environment.GetEnvironmentVariable("C64_DEPTH_CLIP") == "1" ? AppFlags.DepthClip : AppFlags.None;
+
+	/// <summary>
+	/// Properties für die Device-Erzeugung (0 = keine). Der Rückruf ist ein unmanaged
+	/// Funktionszeiger ohne Delegate, deshalb AOT-fähig und ohne Lebensdauerfrage.
+	/// </summary>
+	public static uint CreateDeviceProperties()
+	{
+		if (Environment.GetEnvironmentVariable("C64_GPU_TIMING") != "1")
+			return 0;
+
+		if (!GraphicsDevice.IsKitSDLLoaded())
+		{
+			Log.Info("[c64-gpu] Kit fehlt, Callback nicht gesetzt (SDL ohne visionOS-Kit-Exporte)");
+			return 0;
+		}
+
+		var props = SDL_CreateProperties();
+		delegate* unmanaged[Cdecl]<nint, nint, void> callback = &OnCommandBufferCompleted;
+		SDL_SetPointerProperty(props, SDL_PROP_GPU_DEVICE_CREATE_METAL_COMMAND_BUFFER_COMPLETED_CALLBACK_POINTER, (nint)callback);
+		SDL_SetPointerProperty(props, SDL_PROP_GPU_DEVICE_CREATE_METAL_COMMAND_BUFFER_COMPLETED_USERDATA_POINTER, nint.Zero);
+		timing = true;
+		Log.Info("[c64-gpu] Callback gesetzt, Zählung der fertigen Command Buffer einmal pro Sekunde");
+		return props;
+	}
+
+	[UnmanagedCallersOnly(CallConvs = [typeof(CallConvCdecl)])]
+	private static void OnCommandBufferCompleted(nint userdata, nint mtlCommandBuffer)
+	{
+		Interlocked.Increment(ref completedTotal);
+	}
+
+	/// <summary>Anzahl der bisher fertigen Command Buffer (für Hosts wie Celeste64.MacHost).</summary>
+	public static long CompletedTotal => Interlocked.Read(ref completedTotal);
+
+	/// <summary>
+	/// Ausgabeziele für das Endbild statt des Fensters (K6d, F3): ein Durchgang pro Ziel, also
+	/// zum Beispiel ein Target pro Drawable-Schicht. null = Fenster wie bisher.
+	/// </summary>
+	public static IReadOnlyList<IDrawableTarget>? Outputs { get; set; }
+
+	/// <summary>Wird am Ende von Game.Render aufgerufen; der Host zeichnet damit eine Vorschau ins Fenster.</summary>
+	public static Action? AfterRender { get; set; }
+
+	/// <summary>
+	/// Wird pro Ausgabeziel nach dem Endbild aufgerufen, solange dessen Pass noch offen ist; der
+	/// Host kann im selben Pass weiterzeichnen (K6d.3: Test-Viereck in memoryless-Ziele).
+	/// </summary>
+	public static Action<IDrawableTarget>? AfterOutput { get; set; }
+
+	/// <summary>Wird nach dem Rendern der Szene ins Welt-Ziel aufgerufen (vor der Ausgabe); der Host liest es zurück.</summary>
+	public static Action<Target>? AfterSceneRender { get; set; }
+
+	/// <summary>Kantenglättung des Welt-Ziels aus C64_MSAA (1, 2, 4, 8; Standard 1).</summary>
+	public static SampleCount TargetSampleCount => Environment.GetEnvironmentVariable("C64_MSAA") switch
+	{
+		"2" => SampleCount.Two,
+		"4" => SampleCount.Four,
+		"8" => SampleCount.Eight,
+		_ => SampleCount.One,
+	};
+
+	/// <summary>
+	/// Welt-Ziel (Farbe und Tiefe) mit der Kantenglättung aus C64_MSAA. Celeste rendert
+	/// mehrere Pässe in dieses Ziel und sampelt seine Tiefe im Kantenpass (World.cs:874).
+	/// Reverse-Z path: Depth32 (float) instead of Depth16, because near / distance needs the
+	/// float range (the sky at 3 km is 3e-5, two steps of a 16-bit depth) and the device
+	/// drawables are depth32Float as well.
+	/// </summary>
+	public static Target CreateMainTarget(GraphicsDevice device, int width, int height)
+	{
+		var samples = TargetSampleCount;
+		if (samples != SampleCount.One)
+			Log.Info($"[c64-msaa] Welt-Ziel {width}x{height} mit {samples} ({device.Capabilities})");
+		// Celeste rendert in Standard-Z (nah = klein): Tiefenauflösung mit Min, damit Kantenpixel am
+		// Vordergrund hängen; die Samples bleiben gespeichert (MultiSampleStore), weil spätere
+		// Pässe (Rückkopie, Sprites, Erdbeere) das Ziel laden. Reverse-Z: nah = gross, also Max.
+		var depthFormat = ReverseZ ? TextureFormat.Depth32 : TextureFormat.Depth16;
+		var depthResolve = ReverseZ ? DepthResolveFilter.Max : DepthResolveFilter.Min;
+		MainTarget = new Target(device, width, height, [(TextureFormat.Color, TextureFlags.None, samples), (depthFormat, TextureFlags.None, samples)],
+			name: "world", multiSampleStore: true, depthResolve: depthResolve);
+		if (ReverseZ)
+			Log.Info($"[c64-depth] world target {width}x{height} depth={depthFormat} reverseZ=1 scale={WorldScale:F1} units/m");
+		return MainTarget;
+	}
+
+	// ---- Depth convention of the VR path (reverse-Z, infinite far plane) ----
+	//
+	// The device drawables expect hardware depth = near / distance (reverse-Z with an infinite
+	// far plane, as computeProjection produces it); the compositor treats depth 0 as "no
+	// content". Celeste's own convention is standard Z with a linear depth written by the
+	// fragment shaders (LinearizeDepth). With ReverseZ on, the shader variants DefaultVR,
+	// SpriteVR and EdgeVR (no SV_Depth) replace the originals, the projection becomes
+	// reverse-Z infinite, depth clears are 0 and the depth compares are swapped. The near plane
+	// comes from the host in metres (celeste_set_depth_near) and is converted here, at one place,
+	// with the world scale. The reference path (ReverseZ off) is unchanged.
+
+	/// <summary>
+	/// Reverse-Z path on or off. Set by the host before the game is created: the shader
+	/// variants are chosen when the assets load and the world target is created with the game.
+	/// </summary>
+	public static bool ReverseZ { get; set; }
+
+	/// <summary>World units per metre (M4b decision: 10). C64_WORLD_SCALE overrides it for experiments.</summary>
+	public static float WorldScale { get; } =
+		float.TryParse(Environment.GetEnvironmentVariable("C64_WORLD_SCALE"), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var scale) && scale > 0 ? scale : 10f;
+
+	// Near plane of the VR projection in metres, from the host; 0 = not set yet.
+	private static double nearMeters;
+	private static bool nearFallbackLogged;
+	private const double FallbackNearMeters = 0.1;
+
+	/// <summary>Near plane in metres as the host passed it (0 while unknown).</summary>
+	public static double NearMeters => nearMeters;
+
+	/// <summary>
+	/// Sets the near plane of the VR projection in metres (the host reads it from the layer's
+	/// default depth range). Any positive value; the cameras pick it up with their next change.
+	/// </summary>
+	public static void SetNearMeters(double meters)
+	{
+		if (!(meters > 0) || double.IsInfinity(meters))
+			throw new ArgumentOutOfRangeException(nameof(meters), $"near plane must be a positive finite distance in metres, got {meters}");
+		nearMeters = meters;
+		Log.Info($"[c64-depth] near={meters:F3} m -> {NearUnits:F2} units (scale {WorldScale:F1} units/m) reverseZ={(ReverseZ ? 1 : 0)}");
+	}
+
+	/// <summary>
+	/// Near plane of the VR projection in world units: near_m * scale. Before the host set a
+	/// value, 0.1 m with one warning line (the loading ticks run before the host's layer exists).
+	/// </summary>
+	public static float NearUnits
+	{
+		get
+		{
+			var meters = nearMeters;
+			if (meters <= 0)
+			{
+				meters = FallbackNearMeters;
+				if (!nearFallbackLogged)
+				{
+					nearFallbackLogged = true;
+					Log.Warning($"[c64-depth] near plane not set by the host yet, projection uses {meters:F3} m until celeste_set_depth_near");
+				}
+			}
+			return (float)(meters * WorldScale);
+		}
+	}
+
+	/// <summary>
+	/// Radius of the sky dome in metres on the VR path. 3 km: at that distance the stereo
+	/// disparity (0.064 m / 3000 m = 0.0012 degrees) is far below one display pixel, and a head
+	/// movement of 0.1 m shifts the sky by 0.002 degrees, so the compositor's reprojection with
+	/// depth keeps it still; the depth near / R = 0.1 / 3000 = 3.3e-5 stays well above 0 in a
+	/// float depth. Beyond a few kilometres nothing improves, and 1 km would already do.
+	/// </summary>
+	public const double SkyRadiusMeters = 3000;
+
+	/// <summary>Half size of Celeste's skybox cube in world units: the dome radius on the VR path, 300 in the reference.</summary>
+	public static float SkyboxSize => ReverseZ ? (float)(SkyRadiusMeters * WorldScale) : 300f;
+
+	/// <summary>Depth clear value: 0 (far) on the reverse-Z path, 1 in the reference.</summary>
+	public static float DepthClearValue => ReverseZ ? 0f : 1f;
+
+	/// <summary>Depth compare that passes nearer fragments: Greater on the reverse-Z path, Less in the reference.</summary>
+	public static DepthCompare CompareNearer => ReverseZ ? DepthCompare.Greater : DepthCompare.Less;
+
+	/// <summary>Depth compare that passes farther fragments (silhouettes behind geometry): Less on the reverse-Z path, Greater in the reference.</summary>
+	public static DepthCompare CompareFarther => ReverseZ ? DepthCompare.Less : DepthCompare.Greater;
+
+	/// <summary>
+	/// Projection a host puts in place of the cameras' own (the Mac check renders with a test
+	/// projection shaped like computeProjection). Only on the reverse-Z path; null = Celeste's
+	/// field-of-view projection. The cameras cache their projection and pick a new value up with
+	/// their next change.
+	/// </summary>
+	public static Matrix? ProjectionOverride { get; set; }
+
+	/// <summary>
+	/// Turns a standard right-handed projection (System.Numerics, depth 0..1) into reverse-Z
+	/// with an infinite far plane: clip z = near, clip w = view distance, so depth = near / distance.
+	/// </summary>
+	public static Matrix ReverseZInfinite(Matrix standard, float near)
+	{
+		var m = standard;
+		m.M33 = 0f;
+		m.M43 = near;
+		return m;
+	}
+
+	/// <summary>
+	/// Reverse-Z infinite projection from view tangents (left, right, top, bottom, all positive),
+	/// the shape of the compositor's computeProjection, with the current near plane in units.
+	/// Row-vector convention like Matrix.CreatePerspectiveOffCenter (right-handed, -Z forward).
+	/// </summary>
+	public static Matrix CreateProjectionFromTangents(float left, float right, float top, float bottom)
+	{
+		var m = Matrix.Identity;
+		m.M11 = 2f / (left + right);
+		m.M22 = 2f / (top + bottom);
+		m.M31 = (right - left) / (left + right);
+		m.M32 = (top - bottom) / (top + bottom);
+		m.M33 = 0f;
+		m.M34 = -1f;
+		m.M43 = NearUnits;
+		m.M44 = 0f;
+		return m;
+	}
+
+	/// <summary>
+	/// Finite standard-Z projection with the same x and y rows as the given projection, for the
+	/// culling frustum: an infinite reverse-Z matrix has no far plane and its near plane row
+	/// extracts as a zero normal (BoundingFrustum.CreatePlanes), so the frustum is built from
+	/// this one with near and far in world units instead.
+	/// </summary>
+	public static Matrix CullingProjection(Matrix projection, float near, float far)
+	{
+		var m = projection;
+		var range = far / (near - far);
+		m.M33 = range;
+		m.M34 = -1f;
+		m.M43 = near * range;
+		m.M44 = 0f;
+		return m;
+	}
+
+	/// <summary>
+	/// After the shaders are loaded: on the reverse-Z path the VR variants (no SV_Depth) take
+	/// the places of Default, Sprite and Edge, so the game's material lookups stay unchanged.
+	/// </summary>
+	public static void SelectShaderVariants(Dictionary<string, Material> materials)
+	{
+		if (!ReverseZ)
+			return;
+		foreach (var name in new[] { "Default", "Sprite", "Edge" })
+		{
+			if (!materials.TryGetValue(name + "VR", out var variant))
+				throw new Exception($"shader variant {name}VR is missing in Content/Shaders (run scripts/compile-vr-shaders.sh)");
+			materials[name] = variant;
+		}
+		Log.Info("[c64-depth] shader variants selected: DefaultVR, SpriteVR, EdgeVR (hardware depth, no SV_Depth)");
+	}
+
+	/// <summary>
+	/// C64_FAR=off: no far limit on the reverse-Z path (no fade, no discard, culling without a
+	/// distance limit); default 800 units like the reference.
+	/// </summary>
+	public static bool FarOff { get; } = Environment.GetEnvironmentVariable("C64_FAR") == "off";
+
+	/// <summary>Far plane of the world camera: 800, or practically infinite with C64_FAR=off on the reverse-Z path.</summary>
+	public static float WorldFarPlane => ReverseZ && FarOff ? 1_000_000f : 800f;
+
+	/// <summary>Edge threshold in world units: 0.001 of the reference far plane (800), independent of C64_FAR.</summary>
+	public const float EdgeThreshold = 0.8f;
+
+	/// <summary>
+	/// Distance the edge pass clamps the linearised depth to: the camera's far plane, but below
+	/// the nearest point of the sky dome, so that the sky always reads as one "far" value.
+	/// </summary>
+	public static float EdgeClampFar(float farPlane) => MathF.Min(farPlane, SkyboxSize * 0.4f);
+
+	/// <summary>C64_STEREO_CLEAR=magenta: the world's clear colour on the stereo path (shows uncovered pixels).</summary>
+	public static Color WorldClearColor { get; } = Environment.GetEnvironmentVariable("C64_STEREO_CLEAR") == "magenta" ? new Color(255, 0, 255, 255) : new Color(0x444c83);
+
+	/// <summary>C64_STEREO_TESTFILL=1: the edge pass paints view 0 red and view 1 green.</summary>
+	public static bool StereoTestFill { get; } = Environment.GetEnvironmentVariable("C64_STEREO_TESTFILL") == "1";
+
+	/// <summary>
+	/// C64_STEREO_NEGATIVE=logical-uv: negative test of the Mac check. The edge pass reads A with
+	/// the logical instead of the physical size, which is wrong under a rasterization rate map
+	/// (physical differs from logical) and must show up as a misaligned copy.
+	/// </summary>
+	public static bool StereoNegativeLogicalUV { get; } = Environment.GetEnvironmentVariable("C64_STEREO_NEGATIVE") == "logical-uv";
+
+	// ---- Stereo world pass into the host's drawable (M4b.3a) ----
+	//
+	// The host hands over its drawable (colour and depth as 2D arrays with one layer per eye),
+	// the compositor's rasterization rate map and one reverse-Z projection per eye. World renders
+	// its 3D passes into an intermediate 2D array A of the map's physical size (one pass for both
+	// views through vertex amplification, map at the pass), the edge pass reads A at the physical
+	// pixel and writes colour and the copied depth into the drawable, and the sprite and
+	// transparent passes draw into the drawable afterwards. The imported drawables are cached by
+	// texture identity and released after 120 frames unseen.
+
+	/// <summary>Per-frame data of the stereo world pass, valid from BeginVRFrame to EndVRFrame.</summary>
+	public sealed class VRFrame
+	{
+		/// <summary>Target over the drawable's colour and depth arrays, both views in one pass.</summary>
+		public required Target Drawable;
+		/// <summary>The drawable colour is sRGB-encoded (the device); the shaders convert their output.</summary>
+		public bool ColorSrgb;
+		/// <summary>Reverse-Z infinite projections per eye, near plane in world units.</summary>
+		public Matrix Projection0, Projection1;
+		public int LogicalWidth, LogicalHeight, PhysicalWidth, PhysicalHeight;
+		public nint RateMap;
+	}
+
+	/// <summary>The current stereo frame, null outside of one (then World renders to its own target).</summary>
+	public static VRFrame? Frame { get; private set; }
+
+	/// <summary>Set by World when it rendered into the drawable of the current frame.</summary>
+	public static bool FrameRendered { get; set; }
+
+	/// <summary>The intermediate array A of the stereo pass (colour and Depth32, two layers, physical size).</summary>
+	public static Target? Intermediate { get; private set; }
+
+	/// <summary>Command buffer submissions requested through FlushPass in the current frame.</summary>
+	public static int FlushesThisFrame { get; private set; }
+
+	/// <summary>Outline width of the stereo edge pass in physical pixels (auto: round(physical height / 360)).</summary>
+	public static int StereoLineWidth { get; private set; } = 1;
+
+	private sealed class ImportedDrawable
+	{
+		public required Texture Color;
+		public required Texture Depth;
+		public required Target Target;
+		public long LastSeen;
+	}
+
+	private static readonly Dictionary<(nint Color, nint Depth), ImportedDrawable> imports = [];
+	private const int ImportKeepFrames = 120;
+	private static long frameCounter;
+	private static bool projectionShapeLogged;
+
+	/// <summary>True when the target is the sRGB-encoded drawable of the current stereo frame.</summary>
+	public static bool IsSrgbTarget(IDrawableTarget? target)
+		=> Frame is { } frame && frame.ColorSrgb && ReferenceEquals(target, frame.Drawable);
+
+	/// <summary>
+	/// Begins a stereo frame: imports (or finds) the drawable textures, keeps the intermediate at
+	/// the physical size, sets the rate map on both targets and stores the eye projections with
+	/// the near plane in world units. Call before Game.RenderFrame; EndVRFrame afterwards.
+	/// </summary>
+	public static void BeginVRFrame(GraphicsDevice device, nint colorTexture, nint depthTexture, int width, int height, int layers,
+		bool colorSrgb, nint rateMap, int logicalWidth, int logicalHeight, int physicalWidth, int physicalHeight,
+		Matrix projection0, Matrix projection1)
+	{
+		if (!ReverseZ)
+			throw new InvalidOperationException("the stereo world pass needs the reverse-Z path (celeste_init_options.reverse_z = 1)");
+		if (layers != 2)
+			throw new ArgumentOutOfRangeException(nameof(layers), $"the stereo world pass needs 2 layers, got {layers}");
+		if (Frame != null)
+			throw new InvalidOperationException("BeginVRFrame called twice without EndVRFrame");
+		frameCounter++;
+
+		var key = (colorTexture, depthTexture);
+		if (!imports.TryGetValue(key, out var imported))
+		{
+			var colorProps = SDL_CreateProperties();
+			var depthProps = SDL_CreateProperties();
+			SDL_SetPointerProperty(colorProps, SDL_PROP_GPU_TEXTURE_CREATE_METAL_TEXTURE_POINTER, colorTexture);
+			SDL_SetPointerProperty(depthProps, SDL_PROP_GPU_TEXTURE_CREATE_METAL_TEXTURE_POINTER, depthTexture);
+			try
+			{
+				// render target only: the kit requires the requested usage to be a subset of the
+				// native texture's usage, and a compositor drawable may lack shaderRead
+				var color = new Texture(device, width, height, colorSrgb ? TextureFormat.B8G8R8A8SRGB : TextureFormat.Color, layers, TextureFlags.RenderTarget, colorProps, "drawable-color");
+				var depth = new Texture(device, width, height, TextureFormat.Depth32, layers, TextureFlags.RenderTarget, depthProps, "drawable-depth");
+				var target = new Target(device, [color, depth], 0, SampleCount.One, true, DepthResolveFilter.Sample0, false, false, viewCount: layers, name: "drawable");
+				imported = new ImportedDrawable { Color = color, Depth = depth, Target = target };
+				imports[key] = imported;
+				Log.Info($"[c64-import] drawable imported color=0x{colorTexture:x} depth=0x{depthTexture:x} {width}x{height}x{layers} srgb={(colorSrgb ? 1 : 0)} cached={imports.Count}");
+			}
+			finally
+			{
+				SDL_DestroyProperties(colorProps);
+				SDL_DestroyProperties(depthProps);
+			}
+		}
+		imported.LastSeen = frameCounter;
+
+		// release drawables the host has not shown for a while (the compositor rotates about three)
+		if (imports.Count > 1)
+		{
+			foreach (var (k, v) in imports.ToArray())
+			{
+				if (frameCounter - v.LastSeen <= ImportKeepFrames)
+					continue;
+				v.Target.Dispose();
+				v.Color.Dispose();
+				v.Depth.Dispose();
+				imports.Remove(k);
+				Log.Info($"[c64-import] drawable released color=0x{k.Color:x} depth=0x{k.Depth:x} after {ImportKeepFrames} frames unseen, cached={imports.Count}");
+			}
+		}
+
+		// the intermediate at the physical size (changes with the render quality)
+		var physW = physicalWidth > 0 ? physicalWidth : width;
+		var physH = physicalHeight > 0 ? physicalHeight : height;
+		if (Intermediate == null || Intermediate.Width != physW || Intermediate.Height != physH)
+		{
+			Intermediate?.Dispose();
+			var aColor = new Texture(device, physW, physH, TextureFormat.Color, layers, TextureFlags.RenderTarget | TextureFlags.Sampled, 0, "stereo-intermediate-color") { AllowArraySampling = true };
+			var aDepth = new Texture(device, physW, physH, TextureFormat.Depth32, layers, TextureFlags.RenderTarget | TextureFlags.Sampled, 0, "stereo-intermediate-depth") { AllowArraySampling = true };
+			Intermediate = new Target(device, [aColor, aDepth], 0, SampleCount.One, true, DepthResolveFilter.Sample0, false, false, viewCount: layers, name: "stereo-intermediate");
+			StereoLineWidth = Math.Max(1, (int)MathF.Round(physH / 360f));
+			Log.Info($"[c64-stereo] intermediate {physW}x{physH}x{layers} (colour and Depth32), drawable {width}x{height}, logical {logicalWidth}x{logicalHeight}, outline {StereoLineWidth} px, map={(rateMap != 0 ? 1 : 0)}");
+		}
+
+		// rate map on both targets (the compositor hands out a new one each frame)
+		var logicalW = logicalWidth > 0 ? logicalWidth : width;
+		var logicalH = logicalHeight > 0 ? logicalHeight : height;
+		if (rateMap != 0)
+		{
+			imported.Target.SetRasterizationRateMap(rateMap, logicalW, logicalH);
+			Intermediate.SetRasterizationRateMap(rateMap, logicalW, logicalH);
+		}
+		else
+		{
+			imported.Target.ClearRasterizationRateMap();
+			Intermediate.ClearRasterizationRateMap();
+		}
+
+		// the host's projections carry the near plane in metres; in world units it is NearUnits
+		// (the x and y rows are scale free), the one place where the unit conversion happens
+		projection0.M43 = NearUnits;
+		projection1.M43 = NearUnits;
+		if (!projectionShapeLogged)
+		{
+			projectionShapeLogged = true;
+			var (l0, r0, t0, b0) = Tangents(projection0);
+			var (l1, r1, t1, b1) = Tangents(projection1);
+			Log.Info($"[c64-stereo] projections eye0 tangents l={l0:F3} r={r0:F3} t={t0:F3} b={b0:F3} eye1 l={l1:F3} r={r1:F3} t={t1:F3} b={b1:F3} M33={projection0.M33:F3}/{projection1.M33:F3} (0 = infinite far) near={NearUnits:F2} units");
+		}
+
+		Frame = new VRFrame
+		{
+			Drawable = imported.Target,
+			ColorSrgb = colorSrgb,
+			Projection0 = projection0,
+			Projection1 = projection1,
+			LogicalWidth = logicalW,
+			LogicalHeight = logicalH,
+			PhysicalWidth = physW,
+			PhysicalHeight = physH,
+			RateMap = rateMap,
+		};
+		FrameRendered = false;
+		FlushesThisFrame = 0;
+	}
+
+	/// <summary>Ends the stereo frame; returns whether World rendered into the drawable and how many submissions FlushPass made.</summary>
+	public static (bool Rendered, int Flushes) EndVRFrame()
+	{
+		var result = (FrameRendered, FlushesThisFrame);
+		Frame = null;
+		FrameRendered = false;
+		return result;
+	}
+
+	/// <summary>
+	/// Submits the commands recorded so far as their own command buffers, so that a host's
+	/// completion callback can time the passes of a frame (world, edge, sprites) separately.
+	/// </summary>
+	public static void FlushPass(GraphicsDevice device, string name)
+	{
+		device.SubmitCommands();
+		FlushesThisFrame++;
+	}
+
+	/// <summary>View tangents (left, right, top, bottom, all positive) of a projection in the row-vector convention.</summary>
+	public static (float Left, float Right, float Top, float Bottom) Tangents(in Matrix p)
+	{
+		var right = (1 + p.M31) / p.M11;
+		var left = (1 - p.M31) / p.M11;
+		var top = (1 + p.M32) / p.M22;
+		var bottom = (1 - p.M32) / p.M22;
+		return (left, right, top, bottom);
+	}
+
+	/// <summary>
+	/// Reverse-Z projection whose frustum contains both eyes' frusta (the larger tangent on each
+	/// side), for culling with one camera; symmetric in the two eyes, so the sign convention of
+	/// the off-centre terms does not matter.
+	/// </summary>
+	public static Matrix UnionProjection(in Matrix a, in Matrix b)
+	{
+		var (l0, r0, t0, b0) = Tangents(a);
+		var (l1, r1, t1, b1) = Tangents(b);
+		return CreateProjectionFromTangents(MathF.Max(l0, l1), MathF.Max(r0, r1), MathF.Max(t0, t1), MathF.Max(b0, b1));
+	}
+
+	/// <summary>
+	/// The game's main target; World binds its camera to it from the start, so that the camera
+	/// never reads the window's pixel size (a main-thread API in SDL's UIKit backend) from the
+	/// host's render thread before the first render.
+	/// </summary>
+	public static Target? MainTarget { get; private set; }
+
+	// Pause request from the host (the device was taken off and put on again); Game.Update
+	// consumes it on the game's thread and opens the pause menu of a running level.
+	private static int pauseRequested;
+
+	/// <summary>Asks the game to pause at the next update; any thread.</summary>
+	public static void RequestPause() => Interlocked.Exchange(ref pauseRequested, 1);
+
+	/// <summary>True once per request; called from Game.Update.</summary>
+	public static bool ConsumePauseRequest() => Interlocked.Exchange(ref pauseRequested, 0) == 1;
+
+	/// <summary>FMOD mixer suspend or resume for a backgrounded app (see Audio.SuspendMixer).</summary>
+	public static FMOD.RESULT SuspendAudio(bool suspend) => Audio.SuspendMixer(suspend);
+
+	/// <summary>Einmal pro Sekunde aus Game.Update aufrufen.</summary>
+	public static void Tick()
+	{
+		if (!timing || timer.Elapsed.TotalSeconds < 1.0)
+			return;
+		var total = Interlocked.Read(ref completedTotal);
+		var perSecond = (total - completedLast) / timer.Elapsed.TotalSeconds;
+		completedLast = total;
+		timer.Restart();
+		Log.Info($"[c64-gpu] completed command buffers: {perSecond:F1}/s total={total}");
+	}
+}
+#endif
