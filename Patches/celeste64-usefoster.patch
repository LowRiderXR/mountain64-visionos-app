+			DialogScale = ReadFloat("C64_UI_DIALOG_SCALE", 1f, 0.3f, 1f);
+			DialogYSet = Environment.GetEnvironmentVariable("C64_UI_DIALOG_Y") != "off";
+			DialogYDegrees = ReadFloat("C64_UI_DIALOG_Y", 1.5f, -14f, 14f);
+			TestMeasure = Environment.GetEnvironmentVariable("C64_UI_TEST_MEASURE") == "1";
+			SplashScale = ReadFloat("C64_UI_SPLASH_SCALE", 1f, 0.2f, 4f);
+			if (SplashScale != 1)
+				Log.Info($"[c64-ui] C64_UI_SPLASH_SCALE={SplashScale.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} (factor on the strawberry splash quad)");
+			Log.Info($"[c64-ui] C64_UI_DIALOG_Y={(DialogYSet ? DialogYDegrees.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) : "off")} deg above the gaze (centre of the dialog box; off = 100 layer pixels below the top edge)");
+			Log.Info($"[c64-ui] C64_UI_LETTERBOX={(Letterbox ? 1 : 0)} ({(Letterbox ? "cutscene bars drawn head-locked" : "cutscene bars left out in the stereo world")}) C64_UI_DIALOG_SCALE={DialogScale.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} (dialog box and portrait about their top-centre anchor)");
+			if (HudInset)
+				Log.Info($"[c64-ui] C64_UI_HUD_X={HudXDegrees.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)} C64_UI_HUD_Y={HudYDegrees.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)} deg left/above the gaze during play, estimated density {EstimateDensity(HudXDegrees, HudYDegrees):F2} (model from M4a.4b: centre 1.0, 25 deg 0.33, up 14.7 deg 0.82); pause keeps the original corner");
+			else
+				Log.Info("[c64-ui] C64_UI_HUD_X/Y=off: timer and counter at the layer's original corner during play (24.7 deg left, 14.4 deg up, density about 0.35)");
+			Log.Info($"[c64-ui] C64_UI={(Enabled ? 1 : 0)} ({(Enabled ? "the 2D menu as a panel in the stereo world" : "no 2D in the stereo world")})");
+			Log.Info($"[c64-ui] C64_UI_DIST={DistanceMeters.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} m C64_UI_FOV={FovDegrees.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)} deg (distance of the panel, angular width of the UI layer)");
+		}
+
+		private static float ReadFloat(string name, float fallback, float min, float max)
+		{
+			var text = Environment.GetEnvironmentVariable(name);
+			if (text == null || text == "off")
+				return fallback;
+			if (float.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value) && value >= min && value <= max)
+				return value;
+			Log.Warning($"[c64-ui] {name}={text} invalid, using {fallback}");
+			return fallback;
+		}
+
+		/// <summary>
+		/// Rough pixel density of the device's rate map at an angle left of and above the gaze, from
+		/// the measurements of M4a.4b (M5, quality 1.0): horizontal 1.0 up to about 14 degrees (the
+		/// mean density over the 50-degree canvas was 0.85), linear to 0.33 at 25 degrees; upwards 1.0
+		/// to about 12 degrees, linear to 0.82 at 14.7 degrees; the two factors multiplied. An estimate.
+		/// </summary>
+		public static float EstimateDensity(float xDegrees, float yDegrees)
+		{
+			var x = MathF.Abs(xDegrees);
+			var horizontal = x <= 14f ? 1f : MathF.Max(0.1f, 1f - (x - 14f) / (25f - 14f) * (1f - 0.33f));
+			var y = MathF.Abs(yDegrees);
+			var vertical = y <= 12f ? 1f : MathF.Max(0.1f, 1f - (y - 12f) / (14.7f - 12f) * (1f - 0.82f));
+			return horizontal * vertical;
+		}
+
+		/// <summary>
+		/// Anchor of timer and counter on the UI layer during play, in layer pixels: the layer spans
+		/// FovDegrees horizontally (tangent-linear), the anchor sits HudXDegrees left and HudYDegrees
+		/// above the gaze (the layer's centre).
+		/// </summary>
+		public static Vec2 HudAnchor(float layerWidth, float layerHeight)
+		{
+			var halfTan = MathF.Tan(FovDegrees * MathF.PI / 360);
+			var pixelsPerTangent = layerWidth / (2 * halfTan);
+			var x = layerWidth / 2 - MathF.Tan(HudXDegrees * MathF.PI / 180) * pixelsPerTangent;
+			var y = layerHeight / 2 - MathF.Tan(HudYDegrees * MathF.PI / 180) * pixelsPerTangent;
+			return new Vec2(MathF.Round(x), MathF.Round(y));
+		}
+	}
+
+	/// <summary>The transparent UI layer (colour only, the internal size); null until first needed.</summary>
