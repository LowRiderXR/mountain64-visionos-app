+
+	/// <summary>
+	/// Where the wipe is drawn on its layer so that it covers the whole view of both eyes: the
+	/// union of the view tangents (plus a margin) is mapped onto a rectangle of the layer with the
+	/// same aspect ratio (circles stay round). The gaze direction (tangent 0, 0) is the focus of
+	/// the spotlight, its small hole gets the angular radius of the switch.
+	/// </summary>
+	public readonly struct WipeGeometry
+	{
+		public readonly Vec4 Tangents0, Tangents1;
+		/// <summary>uMin, uMax, vMin, vMax of the union in tangent units (v up).</summary>
+		public readonly Vec4 Union;
+		/// <summary>Bounds for ScreenWipe.Render in layer pixels (top-left of the layer).</summary>
+		public readonly Rect Bounds;
+		/// <summary>Used part of the layer (bounds / layer size).</summary>
+		public readonly Vec2 Used;
+		/// <summary>Layer pixel of the gaze direction.</summary>
+		public readonly Vec2 Focus;
+		/// <summary>Radius of the spotlight's small hole in layer pixels.</summary>
+		public readonly float HoleRadiusPixels;
+		public readonly float PixelsPerTangent;
+
+		public WipeGeometry(in Matrix projection0, in Matrix projection1, int layerWidth, int layerHeight, float margin = 0.03f)
+		{
+			var (l0, r0, t0, b0) = Tangents(projection0);
+			var (l1, r1, t1, b1) = Tangents(projection1);
+			Tangents0 = new Vec4(l0, r0, t0, b0);
+			Tangents1 = new Vec4(l1, r1, t1, b1);
+			var scale = 1 + margin;
+			Union = new Vec4(-MathF.Max(l0, l1) * scale, MathF.Max(r0, r1) * scale, -MathF.Max(b0, b1) * scale, MathF.Max(t0, t1) * scale);
+			var uSpan = Union.Y - Union.X;
+			var vSpan = Union.W - Union.Z;
+			PixelsPerTangent = MathF.Min(layerWidth / uSpan, layerHeight / vSpan);
+			var width = uSpan * PixelsPerTangent;
+			var height = vSpan * PixelsPerTangent;
+			Bounds = new Rect(0, 0, width, height);
+			Used = new Vec2(width / layerWidth, height / layerHeight);
+			Focus = new Vec2((0 - Union.X) * PixelsPerTangent, (Union.W - 0) * PixelsPerTangent);
+			HoleRadiusPixels = MathF.Tan(Wipe.HoleDegrees * MathF.PI / 180) * PixelsPerTangent;
+		}
+	}
+
+	/// <summary>[c64-wipe]: one line when a wipe starts to be drawn in the stereo world and one when it ends, with the rendered frame count.</summary>
+	public static class WipeProbe
+	{
+		private static ScreenWipe? current;
+		private static bool currentFromBlack;
+		private static int frames;
+
+		private static float DurationOf(ScreenWipe wipe) => wipe switch
+		{
+			SpotlightWipe => 1.2f,
+			AngledWipe => 0.5f,
+			SlideWipe => 0.2f,
+			_ => 0,
+		};
+
+		private static long startFrame, lastFrame;
+
+		public static void Frame(ScreenWipe wipe, in WipeGeometry geometry, int layerWidth, int layerHeight, long frame)
+		{
+			if (!ReferenceEquals(wipe, current) || wipe.IsFromBlack != currentFromBlack)
+			{
+				End();
+				current = wipe;
+				currentFromBlack = wipe.IsFromBlack;
+				frames = 0;
+				startFrame = frame;
+				Log.Info($"[c64-wipe] start frame={frame} type={wipe.GetType().Name} shown={(Wipe.IsFade(wipe) ? "fade" : "shape")} dir={(wipe.IsFromBlack ? "fromBlack" : "toBlack")} duration={DurationOf(wipe):F1} s percent={wipe.Percent:F2} layer={layerWidth}x{layerHeight} bounds={geometry.Bounds.Width:F0}x{geometry.Bounds.Height:F0} union=[{geometry.Union.X:F3}..{geometry.Union.Y:F3}]x[{geometry.Union.Z:F3}..{geometry.Union.W:F3}] tan focus=({geometry.Focus.X:F0}, {geometry.Focus.Y:F0}) px hole={geometry.HoleRadiusPixels:F0} px ({Wipe.HoleDegrees:F1} deg) pxPerTan={geometry.PixelsPerTangent:F0}");
+			}
+			frames++;
+			lastFrame = frame;
+		}
+
+		/// <summary>Closes the open entry (no wipe drawn in this frame, or another one started).</summary>
+		public static void End()
+		{
+			if (current == null)
+				return;
+			Log.Info($"[c64-wipe] end type={current.GetType().Name} dir={(currentFromBlack ? "fromBlack" : "toBlack")} frames={frames} ({startFrame}..{lastFrame}) percent={current.Percent:F2}");
+			current = null;
+			frames = 0;
+		}
+	}
+
+	/// <summary>World-from-eye (or world-from-head) on a base given as a yaw about Z, see the matrix overload.</summary>
+	public static Matrix WorldFromRelative(in Matrix relative, Vec3 basePosition, float baseYaw)
+		=> WorldFromRelative(relative, basePosition, Matrix.CreateRotationZ(baseYaw));
+
+	/// <summary>
+	/// World-from-eye (or world-from-head) in Celeste's world from a transform relative to the
+	/// host's reference O: axes through ToCelesteDirection, the position scaled with WorldScale,
+	/// both rotated by the base rotation (the game camera's yaw, or its whole rotation in
+	/// CameraBaseMode.Full) and placed at its position. Row-vector layout.
+	/// </summary>
+	public static Matrix WorldFromRelative(in Matrix relative, Vec3 basePosition, in Matrix rz)
+	{
+		var right = Vec3.TransformNormal(ToCelesteDirection(new Vec3(relative.M11, relative.M12, relative.M13)), rz);
+		var up = Vec3.TransformNormal(ToCelesteDirection(new Vec3(relative.M21, relative.M22, relative.M23)), rz);
+		var back = Vec3.TransformNormal(ToCelesteDirection(new Vec3(relative.M31, relative.M32, relative.M33)), rz);
+		var position = basePosition + Vec3.TransformNormal(ToCelesteDirection(new Vec3(relative.M41, relative.M42, relative.M43)) * WorldScale, rz);
+		return new Matrix(
+			right.X, right.Y, right.Z, 0,
+			up.X, up.Y, up.Z, 0,
+			back.X, back.Y, back.Z, 0,
+			position.X, position.Y, position.Z, 1);
+	}
+
+	/// <summary>
+	/// Diagnostics for the Mac host: pixel of a world point for one eye, from the game camera
+	/// (position, look-at), the eye's transform relative to O, a projection and the image size.
+	/// </summary>
+	public static Vec2 DebugProject(Vec3 cameraPosition, Vec3 cameraLookAt, in Matrix eyeRelative, in Matrix projection, Vec3 worldPoint, int width, int height)
+	{
+		Matrix.Invert(WorldFromRelative(eyeRelative, cameraPosition, BaseRotation(cameraPosition, cameraLookAt)), out var view);
+		var clip = Vec4.Transform(new Vec4(worldPoint, 1), view * projection);
+		return new Vec2((clip.X / clip.W + 1) / 2 * width, (1 - clip.Y / clip.W) / 2 * height);
+	}
+
+	/// <summary>The current stereo frame, null outside of one (then World renders to its own target).</summary>
+	public static VRFrame? Frame { get; private set; }
+
+	/// <summary>Set by World when it rendered into the drawable of the current frame.</summary>
+	public static bool FrameRendered { get; set; }
+
+	/// <summary>
+	/// The world target A of the stereo pass (colour and Depth32, two layers, the physical size of
+	/// the drawable under the compositor's rate map): the 3D passes draw into it, the edge pass
+	/// reads it and writes the drawable.
+	/// </summary>
+	public static Target? Intermediate { get; private set; }
+
+	/// <summary>Command buffer submissions requested through FlushPass in the current frame.</summary>
+	public static int FlushesThisFrame { get; private set; }
+
+	/// <summary>Outline width of the stereo edge pass in coarse pixels: one, as in the original.</summary>
+	public static int StereoLineWidth { get; private set; } = 1;
+
+	private sealed class ImportedDrawable
+	{
+		public required Texture Color;
+		public required Texture Depth;
+		public required Target Target;
+		public long LastSeen;
+	}
+
+	private static readonly Dictionary<(nint Color, nint Depth), ImportedDrawable> imports = [];
+	private const int ImportKeepFrames = 120;
+	private static long frameCounter;
+	private static bool projectionShapeLogged;
+	private static bool headPoseLogged;
+
+	/// <summary>True when the target is the sRGB-encoded drawable of the current stereo frame.</summary>
+	public static bool IsSrgbTarget(IDrawableTarget? target)
+		=> Frame is { } frame && frame.ColorSrgb && ReferenceEquals(target, frame.Drawable);
+
+	/// <summary>
+	/// The current stereo frame for a camera that renders the stereo world, that is whose target
+	/// is A or the drawable; null for every other target (title, overworld and
+	/// other cameras keep Celeste's own projection even while a stereo frame is open).
+	/// </summary>
+	public static VRFrame? StereoFrameFor(IDrawableTarget? target)
+	{
+		var frame = Frame;
+		if (frame == null || target == null)
+			return null;
+		return ReferenceEquals(target, frame.Drawable) || ReferenceEquals(target, Intermediate) ? frame : null;
+	}
+
+	/// <summary>
+	/// Begins a stereo frame: imports (or finds) the drawable textures, keeps the world target A at
+	/// the physical size of the drawable, sets the rate map on the drawable and on A and stores the
+	/// eye projections with the near plane in world units. Call before
+	/// Game.RenderFrame; EndVRFrame afterwards.
+	/// </summary>
+	public static void BeginVRFrame(GraphicsDevice device, nint colorTexture, nint depthTexture, int width, int height, int layers,
+		bool colorSrgb, nint rateMap, int logicalWidth, int logicalHeight, int physicalWidth, int physicalHeight,
+		Matrix projection0, Matrix projection1,
+		Matrix eye0Relative, Matrix eye1Relative, Matrix headRelative, Matrix cullingProjection, bool originReset)
+	{
+		if (!ReverseZ)
+			throw new InvalidOperationException("the stereo world pass needs the reverse-Z path (celeste_init_options.reverse_z = 1)");
+		if (layers != 2)
+			throw new ArgumentOutOfRangeException(nameof(layers), $"the stereo world pass needs 2 layers, got {layers}");
+		if (Frame != null)
+			throw new InvalidOperationException("BeginVRFrame called twice without EndVRFrame");
+		frameCounter++;
+
+		var key = (colorTexture, depthTexture);
+		if (!imports.TryGetValue(key, out var imported))
+		{
+			var colorProps = SDL_CreateProperties();
+			var depthProps = SDL_CreateProperties();
+			SDL_SetPointerProperty(colorProps, SDL_PROP_GPU_TEXTURE_CREATE_METAL_TEXTURE_POINTER, colorTexture);
+			SDL_SetPointerProperty(depthProps, SDL_PROP_GPU_TEXTURE_CREATE_METAL_TEXTURE_POINTER, depthTexture);
+			try
+			{
+				// render target only: the kit requires the requested usage to be a subset of the
+				// native texture's usage, and a compositor drawable may lack shaderRead
+				var color = new Texture(device, width, height, colorSrgb ? TextureFormat.B8G8R8A8SRGB : TextureFormat.Color, layers, TextureFlags.RenderTarget, colorProps, "drawable-color");
+				var depth = new Texture(device, width, height, TextureFormat.Depth32, layers, TextureFlags.RenderTarget, depthProps, "drawable-depth");
+				var target = new Target(device, [color, depth], 0, SampleCount.One, true, DepthResolveFilter.Sample0, false, false, viewCount: layers, name: "drawable");
+				imported = new ImportedDrawable { Color = color, Depth = depth, Target = target };
+				imports[key] = imported;
+				Log.Info($"[c64-import] drawable imported color=0x{colorTexture:x} depth=0x{depthTexture:x} {width}x{height}x{layers} srgb={(colorSrgb ? 1 : 0)} cached={imports.Count}");
+			}
+			finally
+			{
+				SDL_DestroyProperties(colorProps);
+				SDL_DestroyProperties(depthProps);
+			}
+		}
+		imported.LastSeen = frameCounter;
+
+		// release drawables the host has not shown for a while (the compositor rotates about three)
+		if (imports.Count > 1)
+		{
+			foreach (var (k, v) in imports)
+				if (frameCounter - v.LastSeen > ImportKeepFrames)
+					expiredImports.Add(k);
+			foreach (var k in expiredImports)
+			{
+				var v = imports[k];
+				v.Target.Dispose();
+				v.Color.Dispose();
+				v.Depth.Dispose();
+				imports.Remove(k);
+				Log.Info($"[c64-import] drawable released color=0x{k.Color:x} depth=0x{k.Depth:x} after {ImportKeepFrames} frames unseen, cached={imports.Count}");
+			}
+			expiredImports.Clear();
+		}
+
+		var physW = physicalWidth > 0 ? physicalWidth : width;
+		var physH = physicalHeight > 0 ? physicalHeight : height;
+		var logicalW = logicalWidth > 0 ? logicalWidth : width;
+		var logicalH = logicalHeight > 0 ? logicalHeight : height;
+
+		// The world target A at the physical size of the drawable under the compositor's map (one
+		// pass for both views through vertex amplification); recreated only when the physical size
+		// (render quality) or MSAA changes. With MSAA the world pass draws into memoryless samples
+		// that are only resolved into A (colour, and depth with max = nearest on the reverse-Z path).
+		// The rate map is set on the drawable and on A every frame (the compositor hands out a new one).
+		if (Intermediate == null || Intermediate.Width != physW || Intermediate.Height != physH || worldMsaa != PixelMsaa)
+		{
+			Intermediate?.Dispose();
+			foreach (var texture in worldTextures)
+				texture.Dispose();
+			var aColor = new Texture(device, physW, physH, TextureFormat.Color, layers, TextureFlags.RenderTarget | TextureFlags.Sampled, 0, "stereo-world-a-color") { AllowArraySampling = true };
+			var aDepth = new Texture(device, physW, physH, TextureFormat.Depth32, layers, TextureFlags.RenderTarget | TextureFlags.Sampled, 0, "stereo-world-a-depth") { AllowArraySampling = true };
+			Intermediate = PixelMsaa > 0
+				? new Target(device, [aColor, aDepth], 0, SampleCount.Four, multiSampleStore: false, DepthResolveFilter.Max, colorMemoryless: true, depthMemoryless: true, viewCount: layers, name: "stereo-world-a")
+				: new Target(device, [aColor, aDepth], 0, SampleCount.One, true, DepthResolveFilter.Sample0, false, false, viewCount: layers, name: "stereo-world-a");
+			worldTextures = [aColor, aDepth];
+			worldMsaa = PixelMsaa;
+			CoarseAllocations++;
+			StereoLineWidth = 1;
+			Log.Info($"[c64-stereo] world A {physW}x{physH}x{layers} (colour and Depth32) msaa={PixelMsaa} edge={EdgeAngleDegrees:F3} deg allocations={CoarseAllocations}, drawable {width}x{height}, logical {logicalW}x{logicalH}, map={(rateMap != 0 ? 1 : 0)}");
+		}
+		if (rateMap != 0)
+		{
+			imported.Target.SetRasterizationRateMap(rateMap, logicalW, logicalH);
+			Intermediate.SetRasterizationRateMap(rateMap, logicalW, logicalH);
+		}
+		else
+		{
+			imported.Target.ClearRasterizationRateMap();
+			Intermediate.ClearRasterizationRateMap();
+		}
+
+		// the host's projections carry the near plane in metres; in world units it is NearUnits
+		// (the x and y rows are scale free), the one place where the unit conversion happens
+		projection0.M43 = NearUnits;
+		projection1.M43 = NearUnits;
+		if (!projectionShapeLogged)
+		{
+			projectionShapeLogged = true;
+			var (l0, r0, t0, b0) = Tangents(projection0);
+			var (l1, r1, t1, b1) = Tangents(projection1);
+			Log.Info($"[c64-stereo] projections eye0 tangents l={l0:F3} r={r0:F3} t={t0:F3} b={b0:F3} eye1 l={l1:F3} r={r1:F3} t={t1:F3} b={b1:F3} M33={projection0.M33:F3}/{projection1.M33:F3} (0 = infinite far) near={NearUnits:F2} units");
+		}
+
+		// head pose relative to O (M4b.4); the shift selftest moves head and eyes 0.5 m to the right
+		if (MatrixSelftest == "shift")
+		{
+			var shift = Matrix.CreateTranslation(0.5f, 0, 0);
+			eye0Relative = shift;
+			eye1Relative = shift;
+			headRelative = shift;
+		}
+
+		StereoSession = new StereoPose
+		{
+			Eye0 = eye0Relative,
+			Eye1 = eye1Relative,
+			Head = headRelative,
+			Culling = cullingProjection,
+			Version = (StereoSession?.Version ?? 0) + 1,
+		};
+		if (originReset)
+			OriginResets++;
+		if (originReset || !headPoseLogged)
+		{
+			headPoseLogged = true;
+			var h = headRelative;
+			Log.Info($"[c64-head] pose relative to O: head=({h.M41:F3}, {h.M42:F3}, {h.M43:F3}) m eye0=({eye0Relative.M41:F3}, {eye0Relative.M42:F3}, {eye0Relative.M43:F3}) eye1=({eye1Relative.M41:F3}, {eye1Relative.M42:F3}, {eye1Relative.M43:F3}) selftest={MatrixSelftest} originReset={(originReset ? 1 : 0)}");
+		}
+
+		Frame = new VRFrame
+		{
+			Drawable = imported.Target,
+			ColorSrgb = colorSrgb,
+			Projection0 = projection0,
+			Projection1 = projection1,
+			LogicalWidth = logicalW,
+			LogicalHeight = logicalH,
+			PhysicalWidth = physW,
+			PhysicalHeight = physH,
+			RateMap = rateMap,
+		};
+		FrameRendered = false;
+		FlushesThisFrame = 0;
+		WorldCommitTicks = 0;
+	}
+
+	/// <summary>Ends the stereo frame; returns whether World rendered into the drawable and how many submissions FlushPass made.</summary>
+	public static (bool Rendered, int Flushes) EndVRFrame()
+	{
+		var result = (FrameRendered, FlushesThisFrame);
+		Frame = null;
+		FrameRendered = false;
+		return result;
+	}
+
+	/// <summary>
+	/// Submits the commands recorded so far as their own command buffers, so that a host's
+	/// completion callback can time the passes of a frame (world, edge, sprites) separately.
+	/// </summary>
+	public static void FlushPass(GraphicsDevice device, string name)
+	{
+		device.SubmitCommands();
+		FlushesThisFrame++;
+		// time of the world commit for the host's toFirstCommit measurement
+		if (name == "world")
+			WorldCommitTicks = System.Diagnostics.Stopwatch.GetTimestamp();
+	}
+
+	/// <summary>View tangents (left, right, top, bottom, all positive) of a projection in the row-vector convention.</summary>
+	public static (float Left, float Right, float Top, float Bottom) Tangents(in Matrix p)
+	{
+		var right = (1 + p.M31) / p.M11;
+		var left = (1 - p.M31) / p.M11;
+		var top = (1 + p.M32) / p.M22;
+		var bottom = (1 - p.M32) / p.M22;
+		return (left, right, top, bottom);
+	}
+
+	/// <summary>
+	/// Reverse-Z projection whose frustum contains both eyes' frusta (the larger tangent on each
+	/// side), for culling with one camera; symmetric in the two eyes, so the sign convention of
+	/// the off-centre terms does not matter.
+	/// </summary>
+	public static Matrix UnionProjection(in Matrix a, in Matrix b)
+	{
+		var (l0, r0, t0, b0) = Tangents(a);
+		var (l1, r1, t1, b1) = Tangents(b);
+		return CreateProjectionFromTangents(MathF.Max(l0, l1), MathF.Max(r0, r1), MathF.Max(t0, t1), MathF.Max(b0, b1));
+	}
+
+	/// <summary>
+	/// The game's main target; World binds its camera to it from the start, so that the camera
+	/// never reads the window's pixel size (a main-thread API in SDL's UIKit backend) from the
+	/// host's render thread before the first render.
+	/// </summary>
+	public static Target? MainTarget { get; private set; }
+
+	// Pause request from the host (the device was taken off and put on again); Game.Update
+	// consumes it on the game's thread and opens the pause menu of a running level.
+	private static int pauseRequested;
+
+	/// <summary>Asks the game to pause at the next update; any thread.</summary>
+	public static void RequestPause() => Interlocked.Exchange(ref pauseRequested, 1);
+
+	/// <summary>True once per request; called from Game.Update.</summary>
+	public static bool ConsumePauseRequest() => Interlocked.Exchange(ref pauseRequested, 0) == 1;
+
+	/// <summary>
+	/// The "connect a game controller" line (App Store badge Controller Required: the app starts
+	/// without a controller and asks for one). Game.Update feeds the state of Foster's controllers
+	/// every tick. The line appears after GraceSeconds without a gamepad, so a gamepad that reports
+	/// late at launch does not flash it, at once when a connected gamepad goes away, and disappears
+	/// as soon as one is connected. A level that loses its gamepad during play pauses on
+	/// LostThisTick. SimulatedConnected replaces the real state for the Mac check (MacHost
+	/// --gamepad-sim); the Mac itself has no gamepad, so the line shows there by default.
+	/// </summary>
+	public static class GamepadPrompt
+	{
+		public const string Text = "Connect a game controller to play";
+		public const float GraceSeconds = 1.5f;
+
+		/// <summary>Mac check: true or false replaces the real connection state; null uses it.</summary>
+		public static bool? SimulatedConnected { get; set; }
+		/// <summary>A controller with IsGamepad is connected (state of the last Update).</summary>
+		public static bool Connected { get; private set; }
+		/// <summary>The line is to be drawn.</summary>
+		public static bool Visible { get; private set; }
+		/// <summary>True in the tick in which the last gamepad disappeared.</summary>
+		public static bool LostThisTick { get; private set; }
+		private static float missingSeconds;
+
+		public static void Update(Input input, float delta)
+		{
+			var connected = false;
+			if (SimulatedConnected is { } simulated)
+				connected = simulated;
+			else
+				foreach (var controller in input.Controllers)
+					if (controller.Connected && controller.IsGamepad)
+					{
+						connected = true;
+						break;
+					}
+			LostThisTick = Connected && !connected;
+			if (connected != Connected)
+				Log.Info($"[c64-gamepad] {(connected ? "connected" : "lost")}{(SimulatedConnected != null ? " (simulated)" : "")}");
+			Connected = connected;
+			// a loss after a connection skips the grace period: the player is waiting for the game
+			missingSeconds = connected ? 0 : LostThisTick ? GraceSeconds : missingSeconds + delta;
+			var visible = !connected && missingSeconds >= GraceSeconds;
+			if (visible != Visible)
+				Log.Info($"[c64-gamepad] connect line {(visible ? "shown" : "hidden")}");
+			Visible = visible;
+		}
+
+		/// <summary>
+		/// Draws the line if it is visible, centred horizontally, in the UI's text style (white with
+		/// the black outline of UI.Text): 12 (* RelativeScale) below the top edge of bounds, or in
+		/// the middle of bounds.
+		/// </summary>
+		public static void Render(Batcher batch, in Rect bounds, bool top)
+		{
+			if (!Visible)
+				return;
+			if (top)
+				UI.Text(batch, Text, bounds.TopCenter + new Vec2(0, 12 * Game.RelativeScale), new Vec2(0.5f, 0), Color.White);
+			else
+				UI.Text(batch, Text, bounds.Center, new Vec2(0.5f, 0.5f), Color.White);
+		}
+	}
+
+	/// <summary>FMOD mixer suspend or resume for a backgrounded app (see Audio.SuspendMixer).</summary>
+	public static FMOD.RESULT SuspendAudio(bool suspend) => Audio.SuspendMixer(suspend);
+
+	/// <summary>Einmal pro Sekunde aus Game.Update aufrufen.</summary>
+	public static void Tick()
+	{
+		if (!timing || timer.Elapsed.TotalSeconds < 1.0)
+			return;
+		var total = Interlocked.Read(ref completedTotal);
+		var perSecond = (total - completedLast) / timer.Elapsed.TotalSeconds;
+		completedLast = total;
+		timer.Restart();
+		Log.Info($"[c64-gpu] completed command buffers: {perSecond:F1}/s total={total}");
+	}
+}
+#endif
