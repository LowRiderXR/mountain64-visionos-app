+	// the compositor's rasterization rate map and one reverse-Z projection per eye. World renders
+	// its 3D passes into an intermediate 2D array A of the map's physical size (one pass for both
+	// views through vertex amplification, map at the pass), the edge pass reads A at the physical
+	// pixel and writes colour and the copied depth into the drawable, and the sprite and
+	// transparent passes draw into the drawable afterwards. The imported drawables are cached by
+	// texture identity and released after 120 frames unseen.
+
+	/// <summary>Per-frame data of the stereo world pass, valid from BeginVRFrame to EndVRFrame.</summary>
+	public sealed class VRFrame
+	{
+		/// <summary>Target over the drawable's colour and depth arrays, both views in one pass.</summary>
+		public required Target Drawable;
+		/// <summary>The drawable colour is sRGB-encoded (the device); the shaders convert their output.</summary>
+		public bool ColorSrgb;
+		/// <summary>Reverse-Z infinite projections per eye, near plane in world units.</summary>
+		public Matrix Projection0, Projection1;
+		public int LogicalWidth, LogicalHeight, PhysicalWidth, PhysicalHeight;
+		public nint RateMap;
+		/// <summary>Fraction of the coarse targets this frame uses per eye (width, height); the upscale pass samples only this part.</summary>
+		public Vec2 Used0, Used1;
+	}
+
+	// ---- Head pose (M4b.4) ----
+	//
+	// The host hands over the eye and head transforms relative to its reference O (position and
+	// yaw of the device anchor at the reference time) in visionOS space (Y up, -Z forward,
+	// metres) and a binocular culling matrix (projection times the view from the device space
+	// into the binocular camera, CompositorServices). Celeste converts at one place
+	// (WorldFromRelative): axes (x, y, z) -> (x, -z, y), scale WorldScale, then the base of the
+	// game camera (position and yaw of LookAt - Position, no pitch). The pose stays available
+	// after the frame (StereoSession), so the update of the next frame culls and sorts with it.
+
+	/// <summary>The last head pose the host handed over, in visionOS space relative to O.</summary>
+	public sealed class StereoPose
+	{
+		/// <summary>Eye transforms (O-from-eye), row-vector layout as copied from simd (rows = axes right, up, back, position).</summary>
+		public Matrix Eye0, Eye1;
+		/// <summary>Head transform (O-from-anchor), same layout.</summary>
+		public Matrix Head;
+		/// <summary>Binocular culling matrix (device space to clip, reverse-Z), from the host.</summary>
+		public Matrix Culling;
+		/// <summary>Changes with every BeginVRFrame; cameras drop their cached stereo matrices when it does.</summary>
+		public int Version;
+	}
+
+	/// <summary>The head pose of the last stereo frame (null before the first); the camera of the world uses it.</summary>
+	public static StereoPose? StereoSession { get; private set; }
+
+	/// <summary>Diagnostics C64_MATRIX_SELFTEST: identity (game camera for both eyes, the M4b.3a image), shift (head 0.5 m to the right), none.</summary>
+	public static string MatrixSelftest { get; } = Environment.GetEnvironmentVariable("C64_MATRIX_SELFTEST") switch
+	{
+		"identity" => "identity",
+		"shift" => "shift",
+		_ => "none",
+	};
+
+	/// <summary>True for a target the stereo world renders into (A, B or an imported drawable), also outside a frame.</summary>
+	public static bool IsStereoTarget(IDrawableTarget? target)
+	{
+		if (target == null)
+			return false;
+		if (ReferenceEquals(target, Intermediate) || ReferenceEquals(target, Composite))
+			return true;
+		foreach (var imported in imports.Values)
+			if (ReferenceEquals(target, imported.Target))
+				return true;
+		return false;
+	}
+
+	/// <summary>Yaw of the game camera's forward (LookAt - Position) in the XY plane: forward = Rz(yaw) * +Y.</summary>
+	public static float BaseYaw(Vec3 position, Vec3 lookAt)
+	{
+		var f = lookAt - position;
+		if (MathF.Abs(f.X) < 1e-6f && MathF.Abs(f.Y) < 1e-6f)
+			return 0;
+		return MathF.Atan2(-f.X, f.Y);
+	}
+
+	/// <summary>
+	/// visionOS direction (Y up, -Z forward) to Celeste direction (Z up, +Y forward): a rotation
+	/// of -90 degrees about X, (x, y, z) -> (x, -z, y).
+	/// </summary>
+	public static Vec3 ToCelesteDirection(Vec3 v) => new(v.X, -v.Z, v.Y);
+
+	/// <summary>
+	/// World-from-eye (or world-from-head) in Celeste's world from a transform relative to the
+	/// host's reference O: axes through ToCelesteDirection, the position scaled with WorldScale,
+	/// both rotated by the game camera's yaw and placed at its position. Row-vector layout.
+	/// </summary>
+	public static Matrix WorldFromRelative(in Matrix relative, Vec3 basePosition, float baseYaw)
+	{
+		var rz = Matrix.CreateRotationZ(baseYaw);
+		var right = Vec3.TransformNormal(ToCelesteDirection(new Vec3(relative.M11, relative.M12, relative.M13)), rz);
+		var up = Vec3.TransformNormal(ToCelesteDirection(new Vec3(relative.M21, relative.M22, relative.M23)), rz);
+		var back = Vec3.TransformNormal(ToCelesteDirection(new Vec3(relative.M31, relative.M32, relative.M33)), rz);
+		var position = basePosition + Vec3.TransformNormal(ToCelesteDirection(new Vec3(relative.M41, relative.M42, relative.M43)) * WorldScale, rz);
+		return new Matrix(
+			right.X, right.Y, right.Z, 0,
+			up.X, up.Y, up.Z, 0,
+			back.X, back.Y, back.Z, 0,
+			position.X, position.Y, position.Z, 1);
+	}
+
+	/// <summary>
+	/// Diagnostics for the Mac host: pixel of a world point for one eye, from the game camera
+	/// (position, look-at), the eye's transform relative to O, a projection and the image size.
+	/// </summary>
+	public static Vec2 DebugProject(Vec3 cameraPosition, Vec3 cameraLookAt, in Matrix eyeRelative, in Matrix projection, Vec3 worldPoint, int width, int height)
+	{
+		Matrix.Invert(WorldFromRelative(eyeRelative, cameraPosition, BaseYaw(cameraPosition, cameraLookAt)), out var view);
+		var clip = Vec4.Transform(new Vec4(worldPoint, 1), view * projection);
+		return new Vec2((clip.X / clip.W + 1) / 2 * width, (1 - clip.Y / clip.W) / 2 * height);
+	}
+
+	/// <summary>The current stereo frame, null outside of one (then World renders to its own target).</summary>
+	public static VRFrame? Frame { get; private set; }
+
+	/// <summary>Set by World when it rendered into the drawable of the current frame.</summary>
+	public static bool FrameRendered { get; set; }
+
+	/// <summary>
+	/// The coarse world target A of the stereo pass (colour and Depth32, two layers): its size per
+	/// eye follows the eye tangents and the pixel density, no rate map (pixel look).
+	/// </summary>
+	public static Target? Intermediate { get; private set; }
+
+	/// <summary>
+	/// The coarse composite B (colour and its own Depth32, two layers, same size as A): the edge
+	/// pass copies A into it with the outline and A's depth, sprites and transparent models follow;
+	/// the upscale pass enlarges it into the drawable.
+	/// </summary>
+	public static Target? Composite { get; private set; }
+
+	/// <summary>Command buffer submissions requested through FlushPass in the current frame.</summary>
+	public static int FlushesThisFrame { get; private set; }
+
+	/// <summary>Outline width of the stereo edge pass in coarse pixels: one, as in the original.</summary>
+	public static int StereoLineWidth { get; private set; } = 1;
+
+	private sealed class ImportedDrawable
+	{
+		public required Texture Color;
+		public required Texture Depth;
+		public required Target Target;
+		public long LastSeen;
+	}
+
+	private static readonly Dictionary<(nint Color, nint Depth), ImportedDrawable> imports = [];
+	private const int ImportKeepFrames = 120;
+	private static long frameCounter;
+	private static bool projectionShapeLogged;
+	private static bool headPoseLogged;
+
+	/// <summary>True when the target is the sRGB-encoded drawable of the current stereo frame.</summary>
+	public static bool IsSrgbTarget(IDrawableTarget? target)
+		=> Frame is { } frame && frame.ColorSrgb && ReferenceEquals(target, frame.Drawable);
+
+	/// <summary>
+	/// The current stereo frame for a camera that renders the stereo world, that is whose target
+	/// is the coarse A or B or the drawable; null for every other target (title, overworld and
+	/// other cameras keep Celeste's own projection even while a stereo frame is open).
+	/// </summary>
+	public static VRFrame? StereoFrameFor(IDrawableTarget? target)
+	{
+		var frame = Frame;
+		if (frame == null || target == null)
+			return null;
+		return ReferenceEquals(target, frame.Drawable) || ReferenceEquals(target, Intermediate) || ReferenceEquals(target, Composite) ? frame : null;
+	}
+
+	/// <summary>
+	/// Begins a stereo frame: imports (or finds) the drawable textures, keeps the coarse targets A
+	/// and B at the size the eye tangents and the pixel density give, sets the rate map on the
+	/// drawable and stores the eye projections with the near plane in world units. Call before
+	/// Game.RenderFrame; EndVRFrame afterwards.
+	/// </summary>
+	public static void BeginVRFrame(GraphicsDevice device, nint colorTexture, nint depthTexture, int width, int height, int layers,
+		bool colorSrgb, nint rateMap, int logicalWidth, int logicalHeight, int physicalWidth, int physicalHeight,
+		Matrix projection0, Matrix projection1,
+		Matrix eye0Relative, Matrix eye1Relative, Matrix headRelative, Matrix cullingProjection, bool originReset)
+	{
+		if (!ReverseZ)
+			throw new InvalidOperationException("the stereo world pass needs the reverse-Z path (celeste_init_options.reverse_z = 1)");
+		if (layers != 2)
+			throw new ArgumentOutOfRangeException(nameof(layers), $"the stereo world pass needs 2 layers, got {layers}");
+		if (Frame != null)
+			throw new InvalidOperationException("BeginVRFrame called twice without EndVRFrame");
+		frameCounter++;
+
+		var key = (colorTexture, depthTexture);
+		if (!imports.TryGetValue(key, out var imported))
+		{
+			var colorProps = SDL_CreateProperties();
+			var depthProps = SDL_CreateProperties();
+			SDL_SetPointerProperty(colorProps, SDL_PROP_GPU_TEXTURE_CREATE_METAL_TEXTURE_POINTER, colorTexture);
+			SDL_SetPointerProperty(depthProps, SDL_PROP_GPU_TEXTURE_CREATE_METAL_TEXTURE_POINTER, depthTexture);
+			try
+			{
+				// render target only: the kit requires the requested usage to be a subset of the
+				// native texture's usage, and a compositor drawable may lack shaderRead
+				var color = new Texture(device, width, height, colorSrgb ? TextureFormat.B8G8R8A8SRGB : TextureFormat.Color, layers, TextureFlags.RenderTarget, colorProps, "drawable-color");
+				var depth = new Texture(device, width, height, TextureFormat.Depth32, layers, TextureFlags.RenderTarget, depthProps, "drawable-depth");
+				var target = new Target(device, [color, depth], 0, SampleCount.One, true, DepthResolveFilter.Sample0, false, false, viewCount: layers, name: "drawable");
+				imported = new ImportedDrawable { Color = color, Depth = depth, Target = target };
+				imports[key] = imported;
+				Log.Info($"[c64-import] drawable imported color=0x{colorTexture:x} depth=0x{depthTexture:x} {width}x{height}x{layers} srgb={(colorSrgb ? 1 : 0)} cached={imports.Count}");
+			}
+			finally
+			{
+				SDL_DestroyProperties(colorProps);
+				SDL_DestroyProperties(depthProps);
+			}
+		}
+		imported.LastSeen = frameCounter;
+
+		// release drawables the host has not shown for a while (the compositor rotates about three)
+		if (imports.Count > 1)
+		{
+			foreach (var (k, v) in imports.ToArray())
+			{
+				if (frameCounter - v.LastSeen <= ImportKeepFrames)
+					continue;
+				v.Target.Dispose();
+				v.Color.Dispose();
+				v.Depth.Dispose();
+				imports.Remove(k);
+				Log.Info($"[c64-import] drawable released color=0x{k.Color:x} depth=0x{k.Depth:x} after {ImportKeepFrames} frames unseen, cached={imports.Count}");
+			}
+		}
+
+		var physW = physicalWidth > 0 ? physicalWidth : width;
+		var physH = physicalHeight > 0 ? physicalHeight : height;
+		var logicalW = logicalWidth > 0 ? logicalWidth : width;
+		var logicalH = logicalHeight > 0 ? logicalHeight : height;
+
+		// Pixel look: the coarse targets A (world) and B (edge, sprites) with a size fixed once,
+		// from the eye tangents of the first frame and the pixel density, width k·(tanL + tanR),
+		// height k·(tanT + tanB), k = density · 180/π, plus a reserve, rounded up to a multiple of
+		// 16; recreated only when density or MSAA change. The tangents fluctuate slightly from
+		// frame to frame, and a texture per size would pile up (SDL releases the old ones late).
+		// So the fluctuation only changes the projection and the used region: the projection is
+		// widened to the right and bottom until the whole texture spans exactly k pixels per unit
+		// tangent, and the upscale pass samples only the used fraction. No rate map on A and B:
+		// the raster is uniform in tangent space, the upscale pass maps it onto the drawable under
+		// the host's map. With MSAA the world pass draws into memoryless samples that are only
+		// resolved into A (colour, and depth with max = nearest on the reverse-Z path).
+		var (tl0, tr0, tt0, tb0) = Tangents(projection0);
+		var (tl1, tr1, tt1, tb1) = Tangents(projection1);
+		var pixelsPerTan = PixelsPerTangent;
+		if (PixelLook == PixelLookMode.World)
+		{
+			// Pixel look in the world (M4b.3a path): A at the physical size of the drawable under the
+			// compositor's map, no B; recreated only when the physical size (render quality) or MSAA
+			// changes. The rate map is set every frame (the compositor hands out a new one).
+			if (Intermediate == null || Intermediate.Width != physW || Intermediate.Height != physH || coarseMsaa != PixelMsaa)
+			{
+				Intermediate?.Dispose();
+				Composite?.Dispose();
+				Composite = null;
+				foreach (var texture in coarseTextures)
+					texture.Dispose();
+				var aColor = new Texture(device, physW, physH, TextureFormat.Color, layers, TextureFlags.RenderTarget | TextureFlags.Sampled, 0, "stereo-world-a-color") { AllowArraySampling = true };
+				var aDepth = new Texture(device, physW, physH, TextureFormat.Depth32, layers, TextureFlags.RenderTarget | TextureFlags.Sampled, 0, "stereo-world-a-depth") { AllowArraySampling = true };
+				Intermediate = PixelMsaa > 0
+					? new Target(device, [aColor, aDepth], 0, SampleCount.Four, multiSampleStore: false, DepthResolveFilter.Max, colorMemoryless: true, depthMemoryless: true, viewCount: layers, name: "stereo-world-a")
+					: new Target(device, [aColor, aDepth], 0, SampleCount.One, true, DepthResolveFilter.Sample0, false, false, viewCount: layers, name: "stereo-world-a");
+				coarseTextures = [aColor, aDepth];
+				coarseMsaa = PixelMsaa;
+				CoarseAllocations++;
+				StereoLineWidth = 1;
+				Log.Info($"[c64-stereo] world A {physW}x{physH}x{layers} (colour and Depth32) msaa={PixelMsaa} edge={EdgeAngleDegrees:F3} deg allocations={CoarseAllocations}, drawable {width}x{height}, logical {logicalW}x{logicalH}, map={(rateMap != 0 ? 1 : 0)}");
+			}
+			if (rateMap != 0)
+			{
+				imported.Target.SetRasterizationRateMap(rateMap, logicalW, logicalH);
+				Intermediate.SetRasterizationRateMap(rateMap, logicalW, logicalH);
+			}
+			else
+			{
+				imported.Target.ClearRasterizationRateMap();
+				Intermediate.ClearRasterizationRateMap();
+			}
+			CoarseUsed0 = Vec2.One;
+			CoarseUsed1 = Vec2.One;
+		}
+		else if (Intermediate == null || coarseDensity != PixelDensity || coarseMsaa != PixelMsaa)
+		{
+			var coarseW = Multiple16(pixelsPerTan * MathF.Max(tl0 + tr0, tl1 + tr1) * CoarseReserve);
+			var coarseH = Multiple16(pixelsPerTan * MathF.Max(tt0 + tb0, tt1 + tb1) * CoarseReserve);
+			Intermediate?.Dispose();
+			Composite?.Dispose();
+			foreach (var texture in coarseTextures)
+				texture.Dispose();
+			var aColor = new Texture(device, coarseW, coarseH, TextureFormat.Color, layers, TextureFlags.RenderTarget | TextureFlags.Sampled, 0, "stereo-coarse-a-color") { AllowArraySampling = true };
+			var aDepth = new Texture(device, coarseW, coarseH, TextureFormat.Depth32, layers, TextureFlags.RenderTarget | TextureFlags.Sampled, 0, "stereo-coarse-a-depth") { AllowArraySampling = true };
+			Intermediate = PixelMsaa > 0
+				? new Target(device, [aColor, aDepth], 0, SampleCount.Four, multiSampleStore: false, DepthResolveFilter.Max, colorMemoryless: true, depthMemoryless: true, viewCount: layers, name: "stereo-coarse-a")
+				: new Target(device, [aColor, aDepth], 0, SampleCount.One, true, DepthResolveFilter.Sample0, false, false, viewCount: layers, name: "stereo-coarse-a");
+			var bColor = new Texture(device, coarseW, coarseH, TextureFormat.Color, layers, TextureFlags.RenderTarget | TextureFlags.Sampled, 0, "stereo-coarse-b-color") { AllowArraySampling = true };
+			var bDepth = new Texture(device, coarseW, coarseH, TextureFormat.Depth32, layers, TextureFlags.RenderTarget | TextureFlags.Sampled, 0, "stereo-coarse-b-depth") { AllowArraySampling = true };
+			Composite = new Target(device, [bColor, bDepth], 0, SampleCount.One, true, DepthResolveFilter.Sample0, false, false, viewCount: layers, name: "stereo-coarse-b");
+			coarseTextures = [aColor, aDepth, bColor, bDepth];
+			coarseDensity = PixelDensity;
+			coarseMsaa = PixelMsaa;
+			CoarseAllocations++;
+			StereoLineWidth = 1;
+			Log.Info($"[c64-stereo] coarse A and B {coarseW}x{coarseH}x{layers} (colour and Depth32) density={PixelDensity:F1} px/deg k={pixelsPerTan:F1} px/tan msaa={PixelMsaa} tangents eye0 {tl0 + tr0:F3}x{tt0 + tb0:F3} reserve={CoarseReserve:F2} allocations={CoarseAllocations}, drawable {width}x{height}, logical {logicalW}x{logicalH}, outline {StereoLineWidth} px, map={(rateMap != 0 ? 1 : 0)}");
+		}
+
+		if (PixelLook == PixelLookMode.Raster)
+		{
+			// used region per eye and the widened projections (extra tangent on the right and bottom)
+			var texTanW = Intermediate.Width / pixelsPerTan;
+			var texTanH = Intermediate.Height / pixelsPerTan;
+			if ((tl0 + tr0 > texTanW || tl1 + tr1 > texTanW || tt0 + tb0 > texTanH || tt1 + tb1 > texTanH) && !coarseTooSmallLogged)
+			{
+				coarseTooSmallLogged = true;
+				Log.Warning($"[c64-stereo] coarse texture too small for the tangents of this frame (eye0 {tl0 + tr0:F3}x{tt0 + tb0:F3}, eye1 {tl1 + tr1:F3}x{tt1 + tb1:F3}, texture {texTanW:F3}x{texTanH:F3}); the whole texture spans the frustum, the density drops below {PixelDensity:F1} px/deg");
+			}
+			CoarseUsed0 = Widen(ref projection0, tl0, tr0, tt0, tb0, texTanW, texTanH);
+			CoarseUsed1 = Widen(ref projection1, tl1, tr1, tt1, tb1, texTanW, texTanH);
+		}
+
+		// rate map only on the drawable (the compositor hands out a new one each frame)
+		if (rateMap != 0)
+			imported.Target.SetRasterizationRateMap(rateMap, logicalW, logicalH);
+		else
+			imported.Target.ClearRasterizationRateMap();
+
+		// the host's projections carry the near plane in metres; in world units it is NearUnits
+		// (the x and y rows are scale free), the one place where the unit conversion happens
+		projection0.M43 = NearUnits;
+		projection1.M43 = NearUnits;
+		if (!projectionShapeLogged)
+		{
+			projectionShapeLogged = true;
+			var (l0, r0, t0, b0) = Tangents(projection0);
+			var (l1, r1, t1, b1) = Tangents(projection1);
+			Log.Info($"[c64-stereo] projections eye0 tangents l={l0:F3} r={r0:F3} t={t0:F3} b={b0:F3} eye1 l={l1:F3} r={r1:F3} t={t1:F3} b={b1:F3} M33={projection0.M33:F3}/{projection1.M33:F3} (0 = infinite far) near={NearUnits:F2} units");
+		}
+
+		// head pose relative to O (M4b.4); the shift selftest moves head and eyes 0.5 m to the right
+		if (MatrixSelftest == "shift")
+		{
+			var shift = Matrix.CreateTranslation(0.5f, 0, 0);
+			eye0Relative = shift;
+			eye1Relative = shift;
+			headRelative = shift;
+		}
+
+		// head rotation per frame (diagnosis of the unrest): angle between this and the previous frame
+		if (hasPreviousHead)
+		{
+			var angle = RotationAngleDegrees(previousHead, headRelative);
+			headRotSum += angle;
+			headRotMax = Math.Max(headRotMax, angle);
+			headRotCount++;
+		}
+		previousHead = headRelative;
+		hasPreviousHead = true;
+
+		// frozen head rotation (C64_HEAD_FREEZE=1): captured at the first frame after a world frame,
+		// then the rotation rows of head and eyes are replaced, the position rows stay live
+		if (HeadFreeze)
+		{
+			if (!freezeCaptured && lastFrameRenderedWorld)
+			{
+				freezeCaptured = true;
+				frozenHead = headRelative;
+				frozenEye0 = eye0Relative;
+				frozenEye1 = eye1Relative;
+				Log.Info($"[c64-still] head rotation frozen at stereo frame {frameCounter} (C64_HEAD_FREEZE=1): the image now sticks to the head, translations stay live");
+			}
+			if (freezeCaptured)
+			{
+				headRelative = WithRotationOf(frozenHead, headRelative);
+				eye0Relative = WithRotationOf(frozenEye0, eye0Relative);
+				eye1Relative = WithRotationOf(frozenEye1, eye1Relative);
