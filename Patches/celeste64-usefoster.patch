+	/// <summary>How often the host set its reference O anew (origin_reset in the frame), counted in BeginVRFrame.</summary>
+	public static int OriginResets { get; private set; }
+
+	public enum UiAnchorMode { Following, Frozen }
+	public enum UiTrigger { Start, Resume }
+
+	/// <summary>
+	/// Placement of the pause panel: in front of the head at Ui.DistanceMeters, upright (position
+	/// and yaw of the head, no pitch or roll). Opened by the pause button: frozen at once with the
+	/// head pose of the last frame. Opened by the host's pause request after the device was put on
+	/// again: the panel follows the head until the host sets O anew (the pose right after putting
+	/// the device on is unusable), then it freezes. The pose is kept relative to O together with
+	/// the game camera's base of that moment, so the panel stays where it was in the world.
+	/// </summary>
+	public static class UiTablet
+	{
+		public static bool Open { get; private set; }
+		public static UiAnchorMode Mode { get; private set; }
+		public static UiTrigger Trigger { get; private set; }
+
+		private static UiTrigger pendingTrigger = UiTrigger.Start;
+		private static Matrix relative = Matrix.Identity;   // O-from-panel in visionOS space
+		private static Vec3 basePosition;
+		private static Matrix baseRotation = Matrix.Identity;
+		private static bool hasPose;
+		private static int resetsAtOpen, framesFollowing;
+		private static bool logRequested;
+
+		/// <summary>The next SetPaused(true) comes from the host's pause request (device put on again).</summary>
+		public static void MarkResumeTrigger() => pendingTrigger = UiTrigger.Resume;
+
+		public static void Opened(Vec3 cameraPosition, Vec3 cameraLookAt)
+		{
+			Open = true;
+			Trigger = pendingTrigger;
+			pendingTrigger = UiTrigger.Start;
+			resetsAtOpen = OriginResets;
+			framesFollowing = 0;
+			hasPose = false;
+			Mode = Trigger == UiTrigger.Resume ? UiAnchorMode.Following : UiAnchorMode.Frozen;
+			Place(cameraPosition, cameraLookAt);
+			Log.Info($"[c64-ui] pause panel opened trigger={TriggerName} mode={ModeName} {PoseText()}");
+			logRequested = true;
+		}
+
+		public static void Closed()
+		{
+			if (!Open)
+				return;
+			Open = false;
+			Log.Info($"[c64-ui] pause panel closed mode={ModeName} followingFrames={framesFollowing}");
+		}
+
+		/// <summary>Once per stereo frame while open: a following panel is placed anew and freezes once O was set anew since it opened.</summary>
+		public static void Update(Vec3 cameraPosition, Vec3 cameraLookAt)
+		{
+			if (!Open)
+				return;
+			if (Mode == UiAnchorMode.Following)
+			{
+				framesFollowing++;
+				Place(cameraPosition, cameraLookAt);
+				if (OriginResets != resetsAtOpen)
+				{
+					Mode = UiAnchorMode.Frozen;
+					Log.Info($"[c64-ui] pause panel frozen after {framesFollowing} following frames (origin reset) {PoseText()}");
+					logRequested = true;
+				}
+			}
+			else if (!hasPose)
+			{
+				// opened before the first stereo pose of this session
+				Place(cameraPosition, cameraLookAt);
+				if (hasPose)
+				{
+					Log.Info($"[c64-ui] pause panel placed with the first stereo pose {PoseText()}");
+					logRequested = true;
+				}
+			}
+		}
+
+		/// <summary>True once after opening and after freezing: the caller logs the panel's pixel bounds.</summary>
+		public static bool ConsumeLogRequest()
+		{
+			var requested = logRequested;
+			logRequested = false;
+			return requested;
+		}
+
+		private static void Place(Vec3 cameraPosition, Vec3 cameraLookAt)
+		{
+			var session = StereoSession;
+			if (session == null)
+				return;
+			var h = session.Head;
+			// upright: the head's back axis flattened into the horizontal plane, up = world up
+			var back = new Vec3(h.M31, 0, h.M33);
+			var length = back.Length();
+			back = length > 1e-4f ? back / length : new Vec3(0, 0, 1);
+			var up = Vec3.UnitY;
+			var right = Vec3.Cross(up, back);
+			var yawOnly = new Matrix(
+				right.X, right.Y, right.Z, 0,
+				up.X, up.Y, up.Z, 0,
+				back.X, back.Y, back.Z, 0,
+				h.M41, h.M42, h.M43, 1);
+			// the panel sits DistanceMeters in front of the head (-Z in head space)
+			relative = Matrix.CreateTranslation(0, 0, -Ui.DistanceMeters) * yawOnly;
+			basePosition = cameraPosition;
+			baseRotation = BaseRotation(cameraPosition, cameraLookAt);
+			hasPose = true;
+		}
+
+		/// <summary>World-from-panel in Celeste's world (rows right, up, back, position); false without a pose.</summary>
+		public static bool TryGetWorld(out Matrix world)
+		{
+			world = hasPose ? WorldFromRelative(relative, basePosition, baseRotation) : Matrix.Identity;
+			return hasPose;
+		}
+
+		/// <summary>Half width of the panel in metres from the angular width and the distance.</summary>
+		public static float HalfWidthMeters => Ui.DistanceMeters * MathF.Tan(Ui.FovDegrees * MathF.PI / 360);
+
+		/// <summary>
+		/// Corners of a head-locked layer (timer and counter during play): the full head pose of
+		/// this frame (position, yaw, pitch, roll) on the current camera base, DistanceMeters ahead.
+		/// </summary>
+		public static bool TryGetHeadLockedCorners(float aspect, Vec3 cameraPosition, Vec3 cameraLookAt, out Vec3 c0, out Vec3 c1, out Vec3 c2, out Vec3 c3)
+		{
+			c0 = c1 = c2 = c3 = default;
+			var session = StereoSession;
+			if (session == null)
+				return false;
+			var relativeNow = Matrix.CreateTranslation(0, 0, -Ui.DistanceMeters) * session.Head;
+			var m = WorldFromRelative(relativeNow, cameraPosition, BaseRotation(cameraPosition, cameraLookAt));
+			CornersOf(m, aspect, out c0, out c1, out c2, out c3);
+			return true;
+		}
+
+		private static void CornersOf(in Matrix m, float aspect, out Vec3 c0, out Vec3 c1, out Vec3 c2, out Vec3 c3)
+		{
+			var right = new Vec3(m.M11, m.M12, m.M13);
+			var up = new Vec3(m.M21, m.M22, m.M23);
+			var centre = new Vec3(m.M41, m.M42, m.M43);
+			var halfW = HalfWidthMeters * WorldScale;
+			var halfH = halfW / aspect;
+			c0 = centre - right * halfW + up * halfH;
+			c1 = centre + right * halfW + up * halfH;
+			c2 = centre + right * halfW - up * halfH;
+			c3 = centre - right * halfW - up * halfH;
+		}
+
+		/// <summary>Corners of the panel in Celeste's world: top-left, top-right, bottom-right, bottom-left (texture v grows downwards).</summary>
+		public static bool TryGetCorners(float aspect, out Vec3 c0, out Vec3 c1, out Vec3 c2, out Vec3 c3)
+		{
+			c0 = c1 = c2 = c3 = default;
+			if (!TryGetWorld(out var m))
+				return false;
+			CornersOf(m, aspect, out c0, out c1, out c2, out c3);
+			return true;
+		}
+
+		private static string TriggerName => Trigger == UiTrigger.Resume ? "resume" : "start";
+		private static string ModeName => Mode == UiAnchorMode.Following ? "following" : "frozen";
+
+		private static string PoseText()
+		{
+			if (!hasPose)
+				return "pose=- (no stereo pose yet)";
+			var aspect = InternalWidth / (float)InternalHeight;
+			var width = 2 * HalfWidthMeters;
+			var height = width / aspect;
+			var verticalDegrees = 2 * MathF.Atan(height / 2 / Ui.DistanceMeters) * 180 / MathF.PI;
+			var head = StereoSession!.Head;
+			var forward = -new Vec3(head.M31, head.M32, head.M33);
+			var yaw = MathF.Atan2(forward.X, -forward.Z) * 180 / MathF.PI;
+			TryGetWorld(out var m);
+			return $"head=({head.M41:F2}, {head.M42:F2}, {head.M43:F2}) m headYaw={yaw:F1} panel=({relative.M41:F2}, {relative.M42:F2}, {relative.M43:F2}) m rel. O world=({m.M41:F1}, {m.M42:F1}, {m.M43:F1}) size={width:F2}x{height:F2} m ({Ui.FovDegrees:F1}x{verticalDegrees:F1} deg) dist={Ui.DistanceMeters:F2} m scale={WorldScale:F1}";
+		}
+	}
+
+	// ---- Screen wipes in the stereo world ----
+
+	/// <summary>
+	/// Wipe switches, read once from the environment; the static constructor logs the values.
+	/// C64_WIPE: 1 (default; the game's screen wipes head-locked over the whole view) or 0 (hard
+	/// cut as before). C64_WIPE_HOLE_DEG: angular radius of the spotlight's small hole (default 7.5,
+	/// the size it has on the 50-degree canvas). C64_WIPE_DIST: distance in metres the wipe's depth
+	/// is written at (default 2, like the UI panel).
+	/// </summary>
+	public static class Wipe
+	{
+		public static readonly bool Enabled;
+		public static readonly float HoleDegrees;
+		public static readonly float DistanceMeters;
+		/// <summary>C64_WIPE_STYLE: fade (default; spotlight and angled wipe become a plain fade to black of the same duration, the slide wipe keeps its shape) or original (all shapes over the whole view).</summary>
+		public static readonly WipeStyle Style;
+
+		static Wipe()
+		{
+			Enabled = Environment.GetEnvironmentVariable("C64_WIPE") != "0";
+			HoleDegrees = ReadFloat("C64_WIPE_HOLE_DEG", 7.5f, 1f, 45f);
+			DistanceMeters = ReadFloat("C64_WIPE_DIST", 2f, 0.3f, 50f);
+			var style = Environment.GetEnvironmentVariable("C64_WIPE_STYLE");
+			Style = style == "original" ? WipeStyle.Original : WipeStyle.Fade;
+			if (style != null && style != "original" && style != "fade")
+				Log.Warning($"[c64-wipe] C64_WIPE_STYLE={style} unknown, using fade");
+			Log.Info($"[c64-wipe] C64_WIPE={(Enabled ? 1 : 0)} ({(Enabled ? "screen wipes head-locked over the whole view" : "hard cut, wipes not shown")}) C64_WIPE_STYLE={(Style == WipeStyle.Original ? "original" : "fade")} ({(Style == WipeStyle.Original ? "all shapes" : "spotlight and angled wipe as a fade to black, slide wipe as a shape")}) C64_WIPE_HOLE_DEG={HoleDegrees.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)} C64_WIPE_DIST={DistanceMeters.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} m");
+		}
+
+		/// <summary>True when this wipe is shown as a plain fade in the stereo world (its shape works poorly in stereo).</summary>
+		public static bool IsFade(ScreenWipe wipe) => Style == WipeStyle.Fade && wipe is not SlideWipe;
+
+		private static float ReadFloat(string name, float fallback, float min, float max)
+		{
+			var text = Environment.GetEnvironmentVariable(name);
+			if (text == null)
+				return fallback;
+			if (float.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value) && value >= min && value <= max)
+				return value;
+			Log.Warning($"[c64-wipe] {name}={text} invalid, using {fallback}");
+			return fallback;
+		}
+	}
+
+	public enum WipeStyle { Fade, Original }
+
+	/// <summary>The transparent layer the screen wipe is drawn into (colour only, the internal size); null until first needed.</summary>
+	public static Target? WipeLayer { get; private set; }
+
+	public static Target EnsureWipeLayer(GraphicsDevice device)
+	{
+		if (WipeLayer == null || WipeLayer.Width != InternalWidth || WipeLayer.Height != InternalHeight)
+		{
+			WipeLayer = new Target(device, InternalWidth, InternalHeight, [TextureFormat.Color], name: "wipe-layer");
+			Log.Info($"[c64-wipe] layer {InternalWidth}x{InternalHeight} (colour only, cleared transparent in every frame with a wipe)");
+		}
+		return WipeLayer;
