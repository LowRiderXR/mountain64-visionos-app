new file mode 100644
index 0000000..461989d
--- /dev/null
+++ b/Content/Shaders/UIVRArray.hlsl
@@ -0,0 +1,101 @@
+// visionOS port, 2D in the stereo world: one textured quad that carries the transparent UI layer
+// (the pause menu, counter, timer) into the host's drawable, both views by vertex amplification;
+// with Dim it darkens the whole view instead (black quad in clip space), with Mode.x it carries
+// the screen wipes head-locked over the whole view (texture mapped by the view tangents). The
+// four corners of the panel come in world space; the vertex interpolates them with the quad's
+// texture coordinates (the mesh is the unit quad of the other stereo passes, its positions are
+// unused). The layer holds premultiplied, gamma-encoded colour from the game's batcher; for an
+// sRGB drawable the fragment un-premultiplies, decodes with the same SrgbToLinear as the world
+// shaders and maps the alpha so a dark panel darkens the world as in the 2D original.
+// Depth comes from the hardware (the quad's real distance), compared with Always by the caller.
+// Compiled by scripts/compile-vr-shaders.sh.
+#include "Partials/Methods.hlsl"
+
+// Vertex Shader
+
+cbuffer VertexUniforms : register(b0, space1)
+{
+    float4x4 ViewProjection0;
+    float4x4 ViewProjection1;
+    // world-space corners: top-left, top-right, bottom-right, bottom-left (texture v grows downwards)
+    float4 Corner0;
+    float4 Corner1;
+    float4 Corner2;
+    float4 Corner3;
+    // head-locked mode (Mode.x = 1, the screen wipes): the quad fills the view of each eye in
+    // clip space; the texture coordinate comes from the eye's view tangents (left, right, top,
+    // bottom) mapped into the union rectangle of both eyes (Union: uMin, uMax, vMin, vMax, v up),
+    // so the pattern has the same angular geometry in both eyes and the gaze direction is the
+    // centre of the layer's bounds. Mode.y is the fixed depth written in that mode, Mode.zw the
+    // used part of the layer.
+    float4 Tangents0;
+    float4 Tangents1;
+    float4 Union;
+    float4 Mode;
+};
+
+struct VsInput
+{
+    float2 Position : TEXCOORD0;
+    float2 TexCoord : TEXCOORD1;
+    float4 Color : TEXCOORD2;
+    float4 Type : TEXCOORD4;
+};
+
+struct VsOutput
+{
+    float2 TexCoord : TEXCOORD0;
+    float4 Position : SV_Position;
+};
+
+VsOutput vertex_main(VsInput input, uint viewID : SV_ViewID)
+{
+    VsOutput output;
+    float2 uv = input.TexCoord;
+    if (Mode.x > 0.5)
+    {
+        float4 t = viewID == 0 ? Tangents0 : Tangents1;
+        float u = lerp(-t.x, t.y, uv.x);
+        float v = lerp(t.z, -t.w, uv.y);
+        output.TexCoord = float2((u - Union.x) / (Union.y - Union.x), (Union.w - v) / (Union.w - Union.z)) * Mode.zw;
+        output.Position = float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, Mode.y, 1.0);
+        return output;
+    }
+    float3 top = lerp(Corner0.xyz, Corner1.xyz, uv.x);
+    float3 bottom = lerp(Corner3.xyz, Corner2.xyz, uv.x);
+    float3 world = lerp(top, bottom, uv.y);
+    output.TexCoord = uv;
+    output.Position = mul(viewID == 0 ? ViewProjection0 : ViewProjection1, float4(world, 1.0));
+    return output;
+}
+
+// Fragment Shader
+
+cbuffer FragmentUniforms : register(b0, space3)
+{
+    // 1 for an sRGB drawable (decode the gamma-encoded layer to linear), 0 for the Mac host
+    float SrgbOut;
+    // overall opacity of the panel (1; fades later)
+    float Opacity;
+    // Dim 1: ignore the texture and output black with DimAlpha (the full-view darkening of the
+    // world while paused, the caller passes clip-space corners and identity matrices)
+    float Dim;
+    float DimAlpha;
+};
+
+Texture2D<float4> Texture : register(t0, space2);
+SamplerState TextureSampler : register(s0, space2);
+
+float4 fragment_main(VsOutput input) : SV_Target0
+{
+    float4 col = Texture.Sample(TextureSampler, input.TexCoord);
+    col = lerp(col, float4(0.0, 0.0, 0.0, DimAlpha), Dim);
+    // premultiplied in gamma space: decode the straight colour. The batcher blended in gamma
+    // space, the sRGB drawable blends in linear space; so that a dark panel darkens the world as
+    // much as in the 2D original, its alpha is mapped the same way (1 - a is the share of the
+    // world that stays, decoded like a colour), opaque pixels keep alpha 1.
+    float3 straight = col.a > 0.0 ? col.rgb / col.a : float3(0.0, 0.0, 0.0);
+    float linearAlpha = 1.0 - SrgbToLinear(float3(1.0 - col.a, 0.0, 0.0)).x;
+    float4 decoded = float4(SrgbToLinear(straight) * linearAlpha, linearAlpha);
+    return lerp(col, decoded, SrgbOut) * Opacity;
+}
