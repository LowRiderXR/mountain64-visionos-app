+		// VisionOSKit.Ui.HudAnchor); in the pause at the original position on the frozen panel
+		{
+			var at = !Paused && VisionOSKit.Ui.HudInset ? VisionOSKit.Ui.HudAnchor(bounds.Width, bounds.Height) : bounds.TopLeft + new Vec2(4, 8);
+			if (IsInEndingArea || Save.Instance.SpeedrunTimer)
+			{
+				UI.Timer(batch, Save.CurrentRecord.Time, at);
+				at.Y += UI.IconSize + 4;
+			}
+
+			if (strawbCounterEase > 0)
+			{
+				var wiggle = 1 + MathF.Sin(strawbCounterWiggle * MathF.Tau * 2) * strawbCounterWiggle * .3f;
+
+				batch.PushMatrix(
+					Matrix3x2.CreateTranslation(0, -UI.IconSize / 2) *
+					Matrix3x2.CreateScale(wiggle) *
+					Matrix3x2.CreateTranslation(at + new Vec2(-60 * (1 - Ease.Cube.Out(strawbCounterEase)), UI.IconSize / 2)));
+				UI.Strawberries(batch, Save.CurrentRecord.Strawberries.Count, Vec2.Zero);
+				batch.PopMatrix();
+			}
+
+			// show version number when paused / in ending area
+			if (IsInEndingArea || Paused)
+				UI.Text(batch, Game.VersionString, bounds.BottomLeft + new Vec2(4, -4) * Game.RelativeScale, new Vec2(0, 1), Color.White * 0.25f);
+		}
+
+		// "connect a game controller": in the pause above the menu on the frozen panel, during
+		// play in the middle of the head-locked layer (the gaze)
+		VisionOSKit.GamepadPrompt.Render(batch, bounds, top: Paused);
+	}
+
+	/// <summary>
+	/// visionOS port, stereo frame: the UI layer as one quad in the world (UIVRArray, both views),
+	/// placed by <see cref="VisionOSKit.UiTablet"/> (frozen upright in front of the head, or
+	/// following it until O is set anew). Always on top, with the quad's real depth written for
+	/// the compositor, premultiplied blend, sRGB decoding for the device's drawable.
+	/// </summary>
+	/// <summary>
+	/// visionOS port, stereo frame: the full-view dimming (70 % in the pause with the original
+	/// style, 90 % during the strawberry collect) as a clip-space quad; during the collect it also
+	/// writes a flat depth 50 m behind the scene (the original clears the depth), in the pause it
+	/// leaves the world's depth alone.
+	/// </summary>
+	private void DrawUiDim(VisionOSKit.VRFrame vr)
+	{
+		var layer = VisionOSKit.UILayer;
+		if (layer == null)
+			return;
+		var quad = StereoQuad(ref uiQuad, ref uiQuadSize, new Point2(1, 1), "ui-panel-quad");
+		var srgbOut = vr.ColorSrgb || VisionOSKit.Ui.ForceSrgbDecode ? 1 : 0;
+		var linearSampler = new TextureSampler(TextureFilter.Linear, TextureWrap.Clamp, TextureWrap.Clamp);
+		var dimAlpha = Paused ? 0.70f : uiSplashActive ? 0.90f : 0f;
+		if (dimAlpha <= 0)
+			return;
+		var dimDepth = uiSplashActive ? (float)((VisionOSKit.NearMeters > 0 ? VisionOSKit.NearMeters : 0.1) / 50.0) : 0.5f;
+		uiDimMaterial.CopyFrom(Assets.Materials["UIVRArray"]);
+		uiDimMaterial.Vertex.SetUniformBuffer(new UniformBuffers.UiVertexVR()
+		{
+			ViewProjection0 = Matrix.Identity,
+			ViewProjection1 = Matrix.Identity,
+			Corner0 = new Vec4(-1, 1, dimDepth, 1),
+			Corner1 = new Vec4(1, 1, dimDepth, 1),
+			Corner2 = new Vec4(1, -1, dimDepth, 1),
+			Corner3 = new Vec4(-1, -1, dimDepth, 1),
+		});
+		uiDimMaterial.Fragment.Samplers[0] = new(layer.Attachments[0], linearSampler);
+		uiDimMaterial.Fragment.SetUniformBuffer(new UniformBuffers.UiFragmentVR()
+		{
+			SrgbOut = srgbOut,
+			Opacity = 1,
+			Dim = 1,
+			DimAlpha = dimAlpha,
+		});
+		GraphicsDevice.Draw(new DrawCommand(Camera.Target, quad, uiDimMaterial)
+		{
+			BlendMode = BlendMode.Premultiply,
+			DepthTestEnabled = uiSplashActive,
+			DepthWriteEnabled = uiSplashActive,
+			DepthCompare = DepthCompare.Always,
+			CullMode = CullMode.None,
+		});
+	}
+
+	private void DrawUiPanel(VisionOSKit.VRFrame vr)
+	{
+		var layer = VisionOSKit.UILayer;
+		if (layer == null)
+			return;
+		var aspect = layer.Width / (float)layer.Height;
+		Vec3 c0, c1, c2, c3;
+		if (Paused)
+		{
+			// pause: the frozen, upright panel (following the head until O is set anew)
+			VisionOSKit.UiTablet.Update(Camera.Position, Camera.LookAt);
+			if (!VisionOSKit.UiTablet.TryGetCorners(aspect, out c0, out c1, out c2, out c3))
+				return;
+		}
+		else
+		{
+			// play: head-locked with the full head pose of this frame (timer, strawberry counter)
+			if (!VisionOSKit.UiTablet.TryGetHeadLockedCorners(aspect, Camera.Position, Camera.LookAt, out c0, out c1, out c2, out c3))
+				return;
+		}
+		var quad = StereoQuad(ref uiQuad, ref uiQuadSize, new Point2(1, 1), "ui-panel-quad");
+		var vp0 = Camera.ViewProjectionFor(0);
+		var vp1 = Camera.ViewProjectionFor(1);
+		var srgbOut = vr.ColorSrgb || VisionOSKit.Ui.ForceSrgbDecode ? 1 : 0;
+		var linearSampler = new TextureSampler(TextureFilter.Linear, TextureWrap.Clamp, TextureWrap.Clamp);
+
+		uiMaterial.CopyFrom(Assets.Materials["UIVRArray"]);
+		uiMaterial.Vertex.SetUniformBuffer(new UniformBuffers.UiVertexVR()
+		{
+			ViewProjection0 = vp0,
+			ViewProjection1 = vp1,
+			Corner0 = new Vec4(c0, 1),
+			Corner1 = new Vec4(c1, 1),
+			Corner2 = new Vec4(c2, 1),
+			Corner3 = new Vec4(c3, 1),
+		});
+		uiMaterial.Fragment.Samplers[0] = new(layer.Attachments[0], linearSampler);
+		uiMaterial.Fragment.SetUniformBuffer(new UniformBuffers.UiFragmentVR()
+		{
+			SrgbOut = srgbOut,
+			Opacity = 1,
+			Dim = 0,
+			DimAlpha = 0,
+		});
+		GraphicsDevice.Draw(new DrawCommand(Camera.Target, quad, uiMaterial)
+		{
+			BlendMode = BlendMode.Premultiply,
+			DepthTestEnabled = true,
+			DepthWriteEnabled = true,
+			DepthCompare = DepthCompare.Always,
+			CullMode = CullMode.None,
+		});
+
+		if (VisionOSKit.UiTablet.ConsumeLogRequest())
+		{
+			// bounding box of the panel in eye 0, logical pixels of the drawable (Mac check)
+			float minX = float.MaxValue, minY = float.MaxValue, maxX = float.MinValue, maxY = float.MinValue;
+			foreach (var corner in (ReadOnlySpan<Vec3>)[c0, c1, c2, c3])
+			{
+				var clip = Vec4.Transform(new Vec4(corner, 1), vp0);
+				var x = (clip.X / clip.W + 1) / 2 * vr.LogicalWidth;
+				var y = (1 - clip.Y / clip.W) / 2 * vr.LogicalHeight;
+				minX = MathF.Min(minX, x); maxX = MathF.Max(maxX, x);
+				minY = MathF.Min(minY, y); maxY = MathF.Max(maxY, y);
+			}
+			var menuSize = pauseMenu.CurrentSize;
+			Log.Info($"[c64-ui] panel eye0 bbox px=[{minX:F0}..{maxX:F0}]x[{minY:F0}..{maxY:F0}] of {vr.LogicalWidth}x{vr.LogicalHeight} layer={layer.Width}x{layer.Height} menu={menuSize.X:F0}x{menuSize.Y:F0} srgbOut={srgbOut}");
+		}
+	}
+#endif
