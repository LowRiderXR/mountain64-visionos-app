+		{
+			headPoseLogged = true;
+			var h = headRelative;
+			Log.Info($"[c64-head] pose relative to O: head=({h.M41:F3}, {h.M42:F3}, {h.M43:F3}) m eye0=({eye0Relative.M41:F3}, {eye0Relative.M42:F3}, {eye0Relative.M43:F3}) eye1=({eye1Relative.M41:F3}, {eye1Relative.M42:F3}, {eye1Relative.M43:F3}) selftest={MatrixSelftest} originReset={(originReset ? 1 : 0)}");
+		}
+
+		Frame = new VRFrame
+		{
+			Drawable = imported.Target,
+			ColorSrgb = colorSrgb,
+			Projection0 = projection0,
+			Projection1 = projection1,
+			LogicalWidth = logicalW,
+			LogicalHeight = logicalH,
+			PhysicalWidth = physW,
+			PhysicalHeight = physH,
+			RateMap = rateMap,
+			Used0 = CoarseUsed0,
+			Used1 = CoarseUsed1,
+		};
+		FrameRendered = false;
+		FlushesThisFrame = 0;
+	}
+
+	/// <summary>Ends the stereo frame; returns whether World rendered into the drawable and how many submissions FlushPass made.</summary>
+	public static (bool Rendered, int Flushes) EndVRFrame()
+	{
+		var result = (FrameRendered, FlushesThisFrame);
+		lastFrameRenderedWorld = FrameRendered;
+		Frame = null;
+		FrameRendered = false;
+		return result;
+	}
+
+	/// <summary>
+	/// [c64-still] measurement (diagnosis of the pixel-look unrest), called by World after the
+	/// sprites pass of a stereo frame: once per second the centred quarter of B (layer 0) is read
+	/// back in two consecutive frames and the changed pixels are counted; the line also carries
+	/// the head rotation per frame (mean and max since the last line), the freeze switch and the
+	/// number of coarse allocations. Each readback waits for the GPU to finish the frame so far
+	/// (a few milliseconds), hence only two per second.
+	/// </summary>
+	public static void SampleStillness()
+	{
+		// raster: the composite B; world: A itself (the drawable cannot be read back)
+		if ((Composite ?? Intermediate) is not { } b)
+			return;
+		var w = Math.Max(1, b.Width / 4);
+		var h = Math.Max(1, b.Height / 4);
+		var region = new RectInt((b.Width - w) / 2, (b.Height - h) / 2, w, h);
+		if (stillPrevious != null && frameCounter == stillPreviousFrame + 1)
+		{
+			if (stillCurrent == null || stillCurrent.Length != w * h)
+				stillCurrent = new Color[w * h];
+			b.Attachments[0].GetData<Color>(stillCurrent, region, 0);
+			var changed = 0;
+			for (int i = 0; i < stillCurrent.Length; i++)
+				if (stillCurrent[i] != stillPrevious[i])
+					changed++;
+			var fraction = changed / (double)stillCurrent.Length * 100;
+			var rotMean = headRotCount > 0 ? headRotSum / headRotCount : 0;
+			Log.Info($"[c64-still] changedB={fraction:F2}% region={w}x{h} frames={stillPreviousFrame},{frameCounter} headRot(deg/frame) mean={rotMean:F4} max={headRotMax:F4} n={headRotCount} freeze={(HeadFreeze && freezeCaptured ? 1 : 0)} allocations={CoarseAllocations}");
+			headRotSum = 0;
+			headRotMax = 0;
+			headRotCount = 0;
+			stillPrevious = null;
+			return;
+		}
+		var now = System.Diagnostics.Stopwatch.GetTimestamp();
+		if (now < stillNextTicks)
+			return;
+		stillNextTicks = now + (long)(StillIntervalSeconds * System.Diagnostics.Stopwatch.Frequency);
+		if (stillPrevious == null || stillPrevious.Length != w * h)
+			stillPrevious = new Color[w * h];
+		b.Attachments[0].GetData<Color>(stillPrevious, region, 0);
+		stillPreviousFrame = frameCounter;
+	}
+
+	/// <summary>Angle in degrees between the rotation parts of two transforms (rows = axes).</summary>
+	private static double RotationAngleDegrees(in Matrix a, in Matrix b)
+	{
+		// trace of Raᵀ·Rb = sum of the dot products of the matching axis rows
+		var trace = a.M11 * b.M11 + a.M12 * b.M12 + a.M13 * b.M13
+			+ a.M21 * b.M21 + a.M22 * b.M22 + a.M23 * b.M23
+			+ a.M31 * b.M31 + a.M32 * b.M32 + a.M33 * b.M33;
+		var cos = Math.Clamp((trace - 1) / 2, -1.0, 1.0);
+		return Math.Acos(cos) * 180 / Math.PI;
+	}
+
+	/// <summary>The rotation rows of one transform with the position row of another.</summary>
+	private static Matrix WithRotationOf(in Matrix rotation, in Matrix position)
+	{
+		var m = rotation;
+		m.M41 = position.M41;
+		m.M42 = position.M42;
+		m.M43 = position.M43;
+		m.M44 = position.M44;
+		return m;
+	}
+
+	/// <summary>
+	/// Submits the commands recorded so far as their own command buffers, so that a host's
+	/// completion callback can time the passes of a frame (world, edge, sprites) separately.
+	/// </summary>
+	public static void FlushPass(GraphicsDevice device, string name)
+	{
+		device.SubmitCommands();
+		FlushesThisFrame++;
+	}
+
+	/// <summary>Smallest multiple of 16 not below the value (texture sizes of the coarse targets).</summary>
+	private static int Multiple16(float value)
+	{
+		var n = Math.Max(16, (int)MathF.Ceiling(value));
+		return (n + 15) / 16 * 16;
+	}
+
+	/// <summary>
+	/// Widens an eye projection on the right and bottom so that its frustum spans the given tangent
+	/// extents (the whole coarse texture at exactly k pixels per unit tangent); the x and y rows
+	/// change, the depth rows stay. Returns the fraction of the texture the original frustum uses.
+	/// A frustum larger than the texture is left as it is (used fraction 1, lower density).
+	/// </summary>
+	private static Vec2 Widen(ref Matrix p, float left, float right, float top, float bottom, float tanWidth, float tanHeight)
+	{
+		var w = MathF.Max(left + right, tanWidth);
+		var h = MathF.Max(top + bottom, tanHeight);
+		var wideRight = w - left;
+		var wideBottom = h - top;
+		p.M11 = 2f / (left + wideRight);
+		p.M31 = (wideRight - left) / (left + wideRight);
+		p.M22 = 2f / (top + wideBottom);
+		p.M32 = (top - wideBottom) / (top + wideBottom);
+		return new Vec2((left + right) / w, (top + bottom) / h);
+	}
+
+	/// <summary>View tangents (left, right, top, bottom, all positive) of a projection in the row-vector convention.</summary>
+	public static (float Left, float Right, float Top, float Bottom) Tangents(in Matrix p)
+	{
+		var right = (1 + p.M31) / p.M11;
+		var left = (1 - p.M31) / p.M11;
+		var top = (1 + p.M32) / p.M22;
+		var bottom = (1 - p.M32) / p.M22;
+		return (left, right, top, bottom);
+	}
+
+	/// <summary>
+	/// Reverse-Z projection whose frustum contains both eyes' frusta (the larger tangent on each
+	/// side), for culling with one camera; symmetric in the two eyes, so the sign convention of
+	/// the off-centre terms does not matter.
+	/// </summary>
+	public static Matrix UnionProjection(in Matrix a, in Matrix b)
+	{
+		var (l0, r0, t0, b0) = Tangents(a);
+		var (l1, r1, t1, b1) = Tangents(b);
+		return CreateProjectionFromTangents(MathF.Max(l0, l1), MathF.Max(r0, r1), MathF.Max(t0, t1), MathF.Max(b0, b1));
+	}
+
+	/// <summary>
+	/// The game's main target; World binds its camera to it from the start, so that the camera
+	/// never reads the window's pixel size (a main-thread API in SDL's UIKit backend) from the
+	/// host's render thread before the first render.
+	/// </summary>
+	public static Target? MainTarget { get; private set; }
+
+	// Pause request from the host (the device was taken off and put on again); Game.Update
+	// consumes it on the game's thread and opens the pause menu of a running level.
+	private static int pauseRequested;
+
+	/// <summary>Asks the game to pause at the next update; any thread.</summary>
+	public static void RequestPause() => Interlocked.Exchange(ref pauseRequested, 1);
+
+	/// <summary>True once per request; called from Game.Update.</summary>
+	public static bool ConsumePauseRequest() => Interlocked.Exchange(ref pauseRequested, 0) == 1;
+
+	/// <summary>FMOD mixer suspend or resume for a backgrounded app (see Audio.SuspendMixer).</summary>
+	public static FMOD.RESULT SuspendAudio(bool suspend) => Audio.SuspendMixer(suspend);
+
+	/// <summary>Einmal pro Sekunde aus Game.Update aufrufen.</summary>
+	public static void Tick()
+	{
+		if (!timing || timer.Elapsed.TotalSeconds < 1.0)
+			return;
+		var total = Interlocked.Read(ref completedTotal);
+		var perSecond = (total - completedLast) / timer.Elapsed.TotalSeconds;
+		completedLast = total;
+		timer.Restart();
+		Log.Info($"[c64-gpu] completed command buffers: {perSecond:F1}/s total={total}");
+	}
+}
