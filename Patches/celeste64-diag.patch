+// K6cDiag.cs — TEMPORÄRE Diagnose für K6c (NaN-Suche und Geschwindigkeitsmessung). Nicht Teil
+// eines Patches; wird nach der Analyse wieder entfernt.
+//
+//   C64_DIAG=1              NaN-Prüfung an Checkpoints in Player und World.SolidWallCheck, Messung
+//                           von Sprunghöhe, Dash-Länge und Wipe-Dauer (Spielzeit und Wanduhr)
+//   C64_SCRIPT=measure      gescriptete Eingabe: Menü bestätigen, dann 3 Sprünge und 3 Dashes
+//   C64_SCRIPT=monkey       gescriptete Zufallseingabe (Richtungen, Sprung, Dash, Klettern, Kamera)
+//   C64_SCRIPT_SEED=N       Startwert für monkey (Standard 1)
+
+using System.Diagnostics;
+using Foster.Framework;
+using static SDL3.SDL;
+
+namespace Celeste64;
+
+public static class K6cDiag
+{
+	private static readonly bool enabled = Environment.GetEnvironmentVariable("C64_DIAG") == "1";
+	private static readonly string? script = Environment.GetEnvironmentVariable("C64_SCRIPT");
+	private static readonly Stopwatch wall = Stopwatch.StartNew();
+	private static int nanReports;
+	private static int wallReports;
+	private static long wallNaNTotal;
+	private static long wallDegenerateTotal;
+	private static ulong lastPlayerFrame;
+	private static string lastState = "none";
+	private static double lastGameSeconds;
+
+	// Sprungmessung
+	private static bool jumpTracking;
+	private static float jumpStartZ, jumpMaxZ;
+	private static double jumpStartGame, jumpStartWall;
+	// Dashmessung
+	private static Vec3 dashStart;
+	private static double dashStartGame, dashStartWall;
+	// Wipemessung
+	private static double wipeStartGame, wipeStartWall;
+
+	private static bool IsNaN(in Vec3 v) => float.IsNaN(v.X) || float.IsNaN(v.Y) || float.IsNaN(v.Z);
+	private static bool IsNaN(in Vec2 v) => float.IsNaN(v.X) || float.IsNaN(v.Y);
+
+	public static void Player(string where, in Time time, Vec3 position, Vec3 velocity, Vec2 targetFacing, Vec3 groundNormal, bool onGround,
+		Vec3 cameraOriginPos, Vec3 cameraTargetForward, Vec3 cameraPosition, Vec3 cameraLookAt, float fov, Vec2 move, Vec3 climbingWallNormal, string state)
+	{
+		lastPlayerFrame = time.Frame;
+		lastState = state;
+		if (!enabled)
+			return;
+
+		if (jumpTracking)
+		{
+			jumpMaxZ = MathF.Max(jumpMaxZ, position.Z);
+			if (onGround && time.Elapsed.TotalSeconds - jumpStartGame > 0.1)
+			{
+				jumpTracking = false;
+				Log.Info($"[k6c-diag] jump: apex={jumpMaxZ - jumpStartZ:F3} airGame={time.Elapsed.TotalSeconds - jumpStartGame:F4}s airWall={wall.Elapsed.TotalSeconds - jumpStartWall:F4}s delta={time.Delta * 1000:F3}ms");
+			}
+		}
+
+		if (nanReports >= 5)
+			return;
+		if (IsNaN(position) || IsNaN(velocity) || IsNaN(targetFacing) || IsNaN(groundNormal) || IsNaN(cameraOriginPos) || IsNaN(cameraTargetForward)
+			|| IsNaN(cameraPosition) || IsNaN(cameraLookAt) || float.IsNaN(fov) || IsNaN(move) || IsNaN(climbingWallNormal))
+		{
+			nanReports++;
+			Log.Error($"[k6c-diag] NaN #{nanReports} at '{where}' frame={time.Frame} game={time.Elapsed.TotalSeconds:F3}s state={state} onGround={onGround} " +
+				$"pos={position} vel={velocity} targetFacing={targetFacing} groundNormal={groundNormal} camOrigin={cameraOriginPos} camForward={cameraTargetForward} " +
+				$"camPos={cameraPosition} camLookAt={cameraLookAt} fov={fov} move={move} climbNormal={climbingWallNormal} wallNaN={wallNaNTotal} wallDegenerate={wallDegenerateTotal}");
+		}
+	}
+
+	/// <summary>Aus World.SolidWallCheck: ein Dreieck, das die Hüft-/Kopfebene schneidet.</summary>
+	public static void WallProbe(Vec3 point, float radius, Vec3 v0, Vec3 v1, Vec3 v2, Vec3 line0, Vec3 line1, Vec3 next, Vec3 pushout)
+	{
+		if (!enabled)
+			return;
+		var nan = IsNaN(next) || IsNaN(pushout);
+		var degenerate = line0.XY() == line1.XY();
+		if (nan) wallNaNTotal++;
+		if (degenerate) wallDegenerateTotal++;
+		if ((nan || degenerate) && wallReports < 12)
+		{
+			wallReports++;
+			Log.Error($"[k6c-diag] wall {(nan ? "NaN" : "degenerate")} #{wallReports} frame={lastPlayerFrame} point={point} radius={radius} v0={v0} v1={v1} v2={v2} line0={line0} line1={line1} next={next} pushout={pushout}");
+		}
+	}
+
+	public static void JumpStart(float z, in Time time)
+	{
+		if (!enabled) return;
+		jumpTracking = true;
+		jumpStartZ = jumpMaxZ = z;
+		jumpStartGame = time.Elapsed.TotalSeconds;
+		jumpStartWall = wall.Elapsed.TotalSeconds;
+	}
+
+	public static void DashStart(Vec3 position, in Time time)
+	{
+		if (!enabled) return;
+		dashStart = position;
+		dashStartGame = time.Elapsed.TotalSeconds;
+		dashStartWall = wall.Elapsed.TotalSeconds;
+	}
+
+	public static void DashEnd(Vec3 position, in Time time)
+	{
+		if (!enabled) return;
+		Log.Info($"[k6c-diag] dash: lengthXY={(position - dashStart).XY().Length():F3} durationGame={time.Elapsed.TotalSeconds - dashStartGame:F4}s durationWall={wall.Elapsed.TotalSeconds - dashStartWall:F4}s delta={time.Delta * 1000:F3}ms");
+	}
+
+	public static void WipeStart(ScreenWipe wipe)
+	{
+		if (!enabled) return;
+		wipeStartGame = lastGameSeconds;
+		wipeStartWall = wall.Elapsed.TotalSeconds;
+	}
+
+	public static void WipeEnd(ScreenWipe wipe, in Time time)
+	{
+		if (!enabled) return;
+		Log.Info($"[k6c-diag] wipe: {wipe.GetType().Name} fromBlack={wipe.IsFromBlack} durationGame={time.Elapsed.TotalSeconds - wipeStartGame:F4}s durationWall={wall.Elapsed.TotalSeconds - wipeStartWall:F4}s delta={time.Delta * 1000:F3}ms");
+	}
+
+
+	// ---- statische Kartenprüfung: Wandecken genau 3 oder 10 Einheiten über einer Bodenhöhe ----
+	private static World? scannedWorld;
+
+	private static Player? player;
+	private static double teleportAt = -1;
+
+	public static void Scan(World world, Player who)
+	{
+		player = who;
+		if (!enabled || ReferenceEquals(world, scannedWorld))
+			return;
+		scannedWorld = world;
+		var playerPosition = who.Position;
+
+		var floors = new HashSet<float>();
+		var solids = world.All<Solid>();
+		foreach (var actor in solids)
+		{
+			if (actor is not Solid solid || !solid.Collidable) continue;
+			var verts = solid.WorldVertices;
+			foreach (var face in solid.WorldFaces)
+				if (face.Plane.Normal.Z >= 0.7f)
+					for (int i = 0; i < face.VertexCount; i++)
+						floors.Add(verts[face.VertexStart + i].Z);
+		}
+
+		// Höhen wie im Spiel gerechnet (Position + UnitZ * 3 bzw. * 10)
+		var waistHeights = new HashSet<float>();
+		var headHeights = new HashSet<float>();
+		foreach (var f in floors) { waistHeights.Add(f + 3f); headHeights.Add(f + 10f); }
+
+		int candidates3 = 0, candidates10 = 0, nanSpots = 0, logged = 0;
+		int degenerate = 0, degenerateNaN = 0, loggedDeg = 0;
+		float nearestDegenerate = float.MaxValue;
+		foreach (var actor in solids)
+		{
+			if (actor is not Solid solid || !solid.Collidable) continue;
+			var verts = solid.WorldVertices;
+			foreach (var face in solid.WorldFaces)
+			{
+				var n = face.Plane.Normal;
+				if (n.Z <= -1 || n.Z >= 1) continue;
+				var outward = new Vec3(n.X, n.Y, 0).Normalized();
+
+				// a) Ecken genau auf Hüft- oder Kopfhöhe eines Bodens
+				for (int i = 0; i < face.VertexCount; i++)
+				{
+					var v = verts[face.VertexStart + i];
+					foreach (var off in new[] { 3f, 10f })
+					{
+						if (!(off == 3f ? waistHeights.Contains(v.Z) : headHeights.Contains(v.Z))) continue;
+						if (off == 3f) candidates3++; else candidates10++;
+						var p = v + outward * 2;
+						var hits = world.SolidWallCheck(p, 3);
+						bool nan = false;
+						for (int h = 0; h < hits.Count; h++) nan |= IsNaN(hits[h].Pushout);
+						if (nan)
+						{
+							nanSpots++;
+							if (logged++ < 6)
+								Log.Error($"[k6c-diag] scan corner NaN: vertex={v} floor={v.Z - off} offset={off} normal={n} testPoint={p} distToPlayer={(v - playerPosition).Length():F1} solid={solid.GetType().Name}");
+						}
+					}
+				}
+
+				// b) entartete Fächer-Dreiecke (doppelte Ecken oder Fläche ~0)
+				for (int i = 0; i < face.VertexCount - 2; i++)
+				{
+					var a = verts[face.VertexStart + 0];
+					var b = verts[face.VertexStart + i + 1];
+					var c = verts[face.VertexStart + i + 2];
+					var area2 = Vec3.Cross(b - a, c - a).Length();
+					if (a == b || b == c || a == c || area2 < 1e-3f)
+					{
+						degenerate++;
+						var mid = (a + b + c) / 3;
+						nearestDegenerate = MathF.Min(nearestDegenerate, (mid - playerPosition).Length());
+						var p = mid + outward * 2;
+						var hits = world.SolidWallCheck(p, 3);
+						bool nan = false;
+						for (int h = 0; h < hits.Count; h++) nan |= IsNaN(hits[h].Pushout);
+						if (nan) degenerateNaN++;
+						// Höhen-Sweep: an wie vielen Hüfthöhen innerhalb des Dreiecks entsteht NaN?
+						float zMin = MathF.Min(a.Z, MathF.Min(b.Z, c.Z)), zMax = MathF.Max(a.Z, MathF.Max(b.Z, c.Z));
+						int sweepTotal = 0, sweepNaN = 0; float firstNaNZ = float.NaN;
+						for (float z = zMin; z <= zMax; z += 0.05f)
+						{
+							sweepTotal++;
+							var q = new Vec3(p.X, p.Y, z);
+							var hs = world.SolidWallCheck(q, 3);
+							bool qn = false;
+							for (int h = 0; h < hs.Count; h++) qn |= IsNaN(hs[h].Pushout);
+							if (qn) { sweepNaN++; if (float.IsNaN(firstNaNZ)) firstNaNZ = z; }
+						}
+						Log.Info($"[k6c-diag] scan sweep: z={zMin:F2}..{zMax:F2} heights={sweepTotal} NaN={sweepNaN} firstNaNZ={firstNaNZ:F3} waistFloor={firstNaNZ - 3:F3} at xy=({p.X:F1}, {p.Y:F1})");
+						if (loggedDeg++ < 10)
+							Log.Error($"[k6c-diag] scan degenerate{(nan ? " NaN" : "")}: a={a} b={b} c={c} area2={area2:E2} normal={n} testPoint={p} distToPlayer={(mid - playerPosition).Length():F1} solid={solid.GetType().Name} face={face.VertexCount} verts");
+					}
+				}
+			}
+		}
+		Log.Info($"[k6c-diag] scan: solids={solids.Count} floorHeights={floors.Count} corners(+3)={candidates3} corners(+10)={candidates10} cornerNaN={nanSpots} degenerateTriangles={degenerate} degenerateNaN={degenerateNaN} nearestDegenerate={nearestDegenerate:F1} playerPos={playerPosition}");
+	}
+
+	// ---- gescriptete Eingabe über SDL_PushEvent (Tastatur, Standardbelegung: Pfeile, C, X, Z, A/D) ----
+
+	private enum Phase { Menu, Wait, Run, Done }
+	private static Phase phase = Phase.Menu;
+	private static double nextAt;
+	private static int step;
+	private static Random? rng;
+	private static readonly List<(SDL_Scancode key, double releaseAt)> releases = [];
+	private static readonly HashSet<SDL_Scancode> held = [];
+	private static readonly SDL_Scancode[] dirs = [SDL_Scancode.SDL_SCANCODE_UP, SDL_Scancode.SDL_SCANCODE_RIGHT, SDL_Scancode.SDL_SCANCODE_DOWN, SDL_Scancode.SDL_SCANCODE_LEFT];
+
+	public static void Tick(in Time time)
+	{
+		lastGameSeconds = time.Elapsed.TotalSeconds;
+		if (string.IsNullOrEmpty(script))
+			return;
+
+		var now = time.Elapsed.TotalSeconds;
+		for (int i = releases.Count - 1; i >= 0; i--)
+			if (now >= releases[i].releaseAt)
+			{
+				Key(releases[i].key, false);
+				releases.RemoveAt(i);
+			}
+
+		var playerActive = lastPlayerFrame + 1 >= time.Frame && lastState == "Normal";
+
+		switch (phase)
+		{
+			case Phase.Menu:
+				if (playerActive)
+				{
+					phase = Phase.Wait;
+					nextAt = now + 1.5;
+					Log.Info($"[k6c-diag] script '{script}': Spieler aktiv bei game={now:F2}s, Start in 1,5 s");
+					return;
+				}
+				if (now >= nextAt)
+				{
+					Tap(SDL_Scancode.SDL_SCANCODE_C, now, 0.05);
+					nextAt = now + 0.8;
+				}
+				return;
+
+			case Phase.Wait:
+				if (now >= nextAt) { phase = Phase.Run; nextAt = now; step = 0; }
+				return;
+
+			case Phase.Run:
+				if (now < nextAt)
+					return;
+				if (script == "measure")
+					MeasureStep(now);
+				else if (script == "teleport")
+					TeleportStep(now);
+				else if (script == "monkey")
+					MonkeyStep(now);
+				else
+					phase = Phase.Done;
+				return;
+		}
+	}
+
+	private static void MeasureStep(double now)
+	{
+		// 3 Sprünge aus dem Stand (C 0,3 s gehalten), dann 3 Dashes nach -Y (erst kurz «Unten» zum Drehen, dann X)
+		if (step < 3)
+		{
+			Tap(SDL_Scancode.SDL_SCANCODE_C, now, 0.3);
+			nextAt = now + 2.0;
+		}
+		else if (step < 9)
+		{
+			if (step % 2 == 1) { Tap(SDL_Scancode.SDL_SCANCODE_DOWN, now, 0.12); nextAt = now + 0.6; }
+			else { Tap(SDL_Scancode.SDL_SCANCODE_X, now, 0.1); nextAt = now + 2.0; }
+		}
+		else
+		{
+			phase = Phase.Done;
+			Log.Info($"[k6c-diag] script measure fertig bei game={now:F2}s");
+		}
+		step++;
+	}
+
+	private static void TeleportStep(double now)
+	{
+		if (step == 0)
+		{
+			var parts = (Environment.GetEnvironmentVariable("C64_TELEPORT") ?? "-31,489.6,118.4").Split(',');
+			var target = new Vec3(float.Parse(parts[0], System.Globalization.CultureInfo.InvariantCulture), float.Parse(parts[1], System.Globalization.CultureInfo.InvariantCulture), float.Parse(parts[2], System.Globalization.CultureInfo.InvariantCulture));
+			if (player != null) { player.Position = target; player.Stop(); }
+			Log.Info($"[k6c-diag] teleport nach {target} bei game={now:F2}s");
+			nextAt = now + 1.0;
+		}
+		else if (step == 1) { Key(SDL_Scancode.SDL_SCANCODE_RIGHT, true); nextAt = now + 2.0; Log.Info("[k6c-diag] halte Rechts"); }
+		else if (step == 2) { Key(SDL_Scancode.SDL_SCANCODE_RIGHT, false); Key(SDL_Scancode.SDL_SCANCODE_LEFT, true); nextAt = now + 2.0; Log.Info("[k6c-diag] halte Links"); }
+		else if (step == 3) { Key(SDL_Scancode.SDL_SCANCODE_LEFT, false); Key(SDL_Scancode.SDL_SCANCODE_UP, true); nextAt = now + 2.0; Log.Info("[k6c-diag] halte Oben"); }
+		else { Key(SDL_Scancode.SDL_SCANCODE_UP, false); phase = Phase.Done; Log.Info("[k6c-diag] teleport-Skript fertig"); }
+		step++;
+	}
+
+	private static void MonkeyStep(double now)
+	{
+		rng ??= new Random(int.TryParse(Environment.GetEnvironmentVariable("C64_SCRIPT_SEED"), out var s) ? s : 1);
+
+		// Richtung neu würfeln (0 = keine, sonst eine der 8 Richtungen)
+		foreach (var d in dirs) Key(d, false);
+		Key(SDL_Scancode.SDL_SCANCODE_A, false);
+		Key(SDL_Scancode.SDL_SCANCODE_D, false);
+		var dir = rng.Next(9);
+		if (dir > 0)
+		{
+			var primary = dirs[(dir - 1) % 4];
+			Key(primary, true);
+			if (dir > 4)
+				Key(dirs[dir % 4], true); // Nachbar in der Liste = Diagonale
+		}
+		var roll = rng.NextDouble();
+		if (roll < 0.35)
+			Tap(SDL_Scancode.SDL_SCANCODE_C, now, 0.1 + rng.NextDouble() * 0.25);
+		else if (roll < 0.55)
+			Tap(SDL_Scancode.SDL_SCANCODE_X, now, 0.1);
+		if (rng.NextDouble() < 0.3)
+			Key(SDL_Scancode.SDL_SCANCODE_Z, !held.Contains(SDL_Scancode.SDL_SCANCODE_Z));
+		if (rng.NextDouble() < 0.15)
+			Key(rng.Next(2) == 0 ? SDL_Scancode.SDL_SCANCODE_A : SDL_Scancode.SDL_SCANCODE_D, true);
+		nextAt = now + 0.2 + rng.NextDouble() * 0.7;
+	}
+
+	private static void Tap(SDL_Scancode key, double now, double hold)
+	{
+		Key(key, true);
+		releases.Add((key, now + hold));
+	}
+
+	private static unsafe void Key(SDL_Scancode key, bool down)
+	{
+		if (down == held.Contains(key))
+			return;
+		if (down) held.Add(key); else held.Remove(key);
+		var ev = default(SDL_Event);
+		ev.key.type = down ? SDL_EventType.SDL_EVENT_KEY_DOWN : SDL_EventType.SDL_EVENT_KEY_UP;
+		ev.key.timestamp = SDL_GetTicksNS();
+		ev.key.scancode = key;
+		ev.key.down = down;
+		ev.key.repeat = false;
+		SDL_PushEvent(ref ev);
+	}
+}
