<Project Sdk="Microsoft.NET.Sdk">

  <!-- Celeste64.MacHost: drives Celeste 64 from the outside like the later Swift host on
       visionOS: create the Game, Begin, Tick with a fixed delta at a real-time rate, End. Always
       builds against the Foster fork (UseLocalFoster) and by default with the kit dylib
       (UseKitSDL=true; -p:UseKitSDL=false takes the SDL 3.4.12 from the fork). The output goes
       to Source/Celeste64/bin/k6c-machost, so that Celeste finds its Content folder (search up
       to five levels upwards from AppContext.BaseDirectory). Celeste stays unchanged; the patch
       Patches/celeste64-usefoster.patch must be applied. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>true</SelfContained>
    <!-- Same .NET servicing release as the device library (Wrapper/Celeste64.VisionOS.csproj),
         so Mac measurements run on the runtime the app ships; the pack comes from NuGet. -->
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <UseKitSDL Condition="'$(UseKitSDL)' == ''">true</UseKitSDL>
    <KitSDLDylib Condition="'$(KitSDLDylib)' == ''">$(MSBuildProjectDirectory)/../../Frameworks/macos/libSDL3.0.dylib</KitSDLDylib>
    <DefineConstants>$(DefineConstants);VISIONOS_KIT</DefineConstants>
    <OutDir>$(MSBuildProjectDirectory)/../../Source/Celeste64/bin/k6c-machost/</OutDir>
  </PropertyGroup>

  <!-- UseLocalFoster and UseKitSDL must also apply to Celeste's restore; therefore pass them as
       global properties when building (scripts/celeste-machost.sh does that):
       dotnet build Tools/Celeste64.MacHost -c Release -p:UseLocalFoster=true -p:UseKitSDL=true -->
  <!-- native/k6d_metal.m is built by scripts/celeste-mac.sh with clang to libk6dmetal.dylib
       next to the program; MSBuild does not know the file. -->
  <ItemGroup>
    <ProjectReference Include="../../Source/Celeste64/Celeste64.csproj" AdditionalProperties="UseLocalFoster=true;UseKitSDL=$(UseKitSDL)" />
  </ItemGroup>

  <!-- The kit dylib as Content with a copy into the output and publish folders (a build target
       alone does not cover the publish, Foster's SDL ended up there). Foster's own SDL copy is
       only suppressed when FosterUseExternalSDL=true is set as a global property (the
       AdditionalProperty of the ProjectReference does not reach the copy targets over two
       levels); scripts/celeste-mac.sh passes it. The explicit copy after the build stays as a
       safety net. -->
  <ItemGroup Condition="'$(UseKitSDL)' == 'true'">
    <Content Include="$(KitSDLDylib)" Link="libSDL3.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="CopyKitSDL" AfterTargets="Build" Condition="'$(UseKitSDL)' == 'true'">
    <Error Condition="!Exists('$(KitSDLDylib)')" Text="Kit SDL not found: $(KitSDLDylib). Run scripts/build-sdl3.sh macos." />
    <Copy SourceFiles="$(KitSDLDylib)" DestinationFiles="$(OutDir)libSDL3.dylib" SkipUnchangedFiles="false" />
  </Target>

</Project>
