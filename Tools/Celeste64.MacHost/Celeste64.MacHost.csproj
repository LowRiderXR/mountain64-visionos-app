<Project Sdk="Microsoft.NET.Sdk">

  <!-- Celeste64.MacHost (K6c): treibt Celeste 64 von aussen wie der spätere Swift-Host auf
       visionOS: Game erzeugen, Begin, Tick mit festem Delta im Echtzeit-Takt, End. Baut immer gegen
       den Foster-Fork (UseLocalFoster) und standardmässig mit der Kit-dylib (UseKitSDL=true;
       -p:UseKitSDL=false nimmt die SDL 3.4.12 aus dem Fork). Die Ausgabe liegt unter
       Source/Celeste64/bin/k6c-machost, damit Celeste seinen Content-Ordner findet (Suche bis
       fünf Ebenen aufwärts von AppContext.BaseDirectory). Celeste bleibt unverändert; der
       Patch Patches/celeste64-usefoster.patch muss angewendet sein. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>true</SelfContained>
    <!-- Same .NET servicing release as the device library (Wrapper/Celeste64.VisionOS.csproj),
         so Mac measurements run on the runtime the app ships; the pack comes from NuGet. -->
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <UseKitSDL Condition="'$(UseKitSDL)' == ''">true</UseKitSDL>
    <KitSDLDylib Condition="'$(KitSDLDylib)' == ''">$(MSBuildProjectDirectory)/../../Frameworks/macos/libSDL3.0.dylib</KitSDLDylib>
    <DefineConstants>$(DefineConstants);VISIONOS_KIT</DefineConstants>
    <OutDir>$(MSBuildProjectDirectory)/../../Source/Celeste64/bin/k6c-machost/</OutDir>
  </PropertyGroup>

  <!-- UseLocalFoster und UseKitSDL müssen auch beim Restore von Celeste gelten; deshalb beim Bau
       als globale Properties übergeben (scripts/celeste-machost.sh macht das):
       dotnet build Tools/Celeste64.MacHost -c Release -p:UseLocalFoster=true -p:UseKitSDL=true -->
  <!-- native/k6d_metal.m (K6d.1) baut scripts/celeste-mac.sh mit clang zu libk6dmetal.dylib
       neben das Programm; MSBuild kennt die Datei nicht. -->
  <ItemGroup>
    <ProjectReference Include="../../Source/Celeste64/Celeste64.csproj" AdditionalProperties="UseLocalFoster=true;UseKitSDL=$(UseKitSDL)" />
  </ItemGroup>

  <!-- Die Kit-dylib als Content mit Kopie in Ausgabe und Publish-Ordner (M0c: ein Build-Ziel
       deckt den Publish nicht ab, dort landete Fosters SDL). Fosters eigene SDL-Kopie wird nur
       unterdrückt, wenn FosterUseExternalSDL=true als globale Property gesetzt ist (die
       AdditionalProperty der ProjectReference erreicht die Kopierziele über zwei Stufen nicht);
       scripts/celeste-mac.sh übergibt sie. Die ausdrückliche Kopie nach dem Build bleibt als
       Sicherheitsnetz. -->
  <ItemGroup Condition="'$(UseKitSDL)' == 'true'">
    <Content Include="$(KitSDLDylib)" Link="libSDL3.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="CopyKitSDL" AfterTargets="Build" Condition="'$(UseKitSDL)' == 'true'">
    <Error Condition="!Exists('$(KitSDLDylib)')" Text="Kit SDL not found: $(KitSDLDylib). Run scripts/build-sdl3.sh macos." />
    <Copy SourceFiles="$(KitSDLDylib)" DestinationFiles="$(OutDir)libSDL3.dylib" SkipUnchangedFiles="false" />
  </Target>

</Project>
